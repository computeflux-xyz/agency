---
/**
 * FramedPhoto — the single entry point for every photograph on the site.
 *
 * Geometry: one chamfered corner, cut with the same `--n` clamp as
 * `organisms/NotchedPanel.astro` (a plain chamfer, not the 12-point notch
 * polygon). The 1px hairline is drawn with the `drop-shadow` stack from the
 * `.notched` utility in global.css and NOT with a `border`: on a single element
 * `filter` is applied before `clip-path`, so the outline has to come from the
 * parent of the clipped box or it would be cut away.
 *
 * Hover / focus (the root is a `group`) traces the chamfered corner: the
 * horizontal bar draws in towards the chamfer, the 2px accent draws along the
 * chamfer itself, then the vertical bar draws away from it.
 */
type Corner = "tl" | "tr" | "bl" | "br" | "none";

interface Props {
  /** 800px-wide asset, e.g. "/photos/hero-focus-800.webp". */
  src: string;
  /** 1600px-wide asset, served as the `2x` srcset candidate. */
  src2x?: string;
  /** Real alt text, or "" when the photo is purely decorative. */
  alt: string;
  /** One-word thematic label revealed on hover, in the corner opposite the chamfer. */
  label?: string;
  corner?: Corner;
  notch?: number;
  /** CSS aspect-ratio for the frame, e.g. "3/4", "16/9". */
  ratio?: string;
  /** Above-the-fold hero photos only. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  src2x,
  alt,
  label,
  corner = "br",
  notch = 34,
  ratio = "4/3",
  priority = false,
  class: className = "",
} = Astro.props;

/* There is no astro:assets pipeline here (the Cloudflare adapter runs
   `imageService: "passthrough"`), so nothing measures the file for us and the
   width/height attributes have to be supplied by hand to avoid layout shift.
   These are the real intrinsic sizes of the shipped `-800` assets; anything not
   listed falls back to an 800px-wide box derived from `ratio`. */
const INTRINSIC: Record<string, [number, number] | undefined> = {
  "hero-whiteboard-800": [600, 800],
  "hero-focus-800": [800, 442],
  "collab-800": [800, 458],
  "reason-baremetal-800": [800, 450],
  "reason-remote-800": [800, 451],
  "reason-measure-800": [800, 574],
  "de-overview-spark-800": [800, 452],
  "de-overview-whiteboard-800": [800, 567],
};

const measured = INTRINSIC[(src.split("/").pop() ?? "").replace(/\.[a-z0-9]+$/i, "")];
const [ratioW, ratioH] = ratio.split("/").map((part) => Number.parseFloat(part.trim()));
const ratioUsable = Number.isFinite(ratioW) && Number.isFinite(ratioH) && ratioW > 0;
const width = measured ? measured[0] : 800;
const height = measured ? measured[1] : ratioUsable ? Math.round((800 * ratioH) / ratioW) : 600;

/* Accent geometry, per chamfered corner. The three pieces read as one
   continuous stroke around the cut corner, so each one's transform-origin sits
   at the point where the previous one ends. */

/** Bar on the horizontal edge; draws *towards* the chamfer. */
const edgeX: Record<Corner, string> = {
  tl: "top-0 left-[var(--n)] origin-right",
  tr: "top-0 right-[var(--n)] origin-left",
  bl: "bottom-0 left-[var(--n)] origin-right",
  br: "bottom-0 right-[var(--n)] origin-left",
  none: "hidden",
};

/** `--n` square pinned in the chamfered corner; its diagonal *is* the chamfer.
 *  Scaling uniformly about a corner that sits on that diagonal keeps the band
 *  collinear with the chamfer, so it appears to draw along the cut edge. */
const chamferBox: Record<Corner, string> = {
  tl: "top-0 left-0 origin-top-right",
  tr: "top-0 right-0 origin-top-left",
  bl: "bottom-0 left-0 origin-bottom-right",
  br: "bottom-0 right-0 origin-bottom-left",
  none: "hidden",
};

/** Gradient axis runs from the clipped-away corner towards the interior, so the
 *  band at `50%` → `50% + 2px` lands flush inside the chamfer. */
const chamferAxis: Record<Corner, string> = {
  tl: "to bottom right",
  tr: "to bottom left",
  bl: "to top right",
  br: "to top left",
  none: "to top left",
};

/** Bar on the vertical edge; draws *away* from the chamfer. */
const edgeY: Record<Corner, string> = {
  tl: "left-0 top-[var(--n)] origin-top",
  tr: "right-0 top-[var(--n)] origin-top",
  bl: "left-0 bottom-[var(--n)] origin-bottom",
  br: "right-0 bottom-[var(--n)] origin-bottom",
  none: "hidden",
};

/** Label sits in the corner opposite the chamfer. */
const labelPos: Record<Corner, string> = {
  tl: "bottom-3 right-3",
  tr: "bottom-3 left-3",
  bl: "top-3 right-3",
  br: "top-3 left-3",
  none: "bottom-3 left-3",
};

const accentBase =
  "fp-accent absolute transition-transform duration-500 ease-[var(--ease-out-expo)]";
---

<figure
  class:list={["group relative", className]}
  style={`--n: clamp(12px, 2.4vw, ${notch}px)`}
>
  <div class="fp-frame h-full">
    <div
      class="fp-clip relative h-full w-full overflow-hidden"
      data-corner={corner}
      style={`aspect-ratio:${ratio}`}
    >
      <img
        src={src}
        srcset={src2x ? `${src} 1x, ${src2x} 2x` : undefined}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
        class="fp-img size-full object-cover contrast-[1.02] saturate-[0.85] transition-[filter,scale] duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04] group-hover:saturate-100 group-focus-visible:scale-[1.04] group-focus-visible:saturate-100"
      />

      <span
        class="fp-veil pointer-events-none absolute inset-0 bg-ink-50/10 transition-opacity duration-700 ease-[var(--ease-out-expo)] group-hover:opacity-0 group-focus-visible:opacity-0"
        aria-hidden="true"></span>

      {
        corner !== "none" && (
          <span class="pointer-events-none absolute inset-0" aria-hidden="true">
            <span
              class:list={[accentBase, "h-[2px] w-8 scale-x-0 bg-flux-blue group-hover:scale-x-100 group-focus-visible:scale-x-100", edgeX[corner]]}
            />
            <span
              class:list={[accentBase, "size-[var(--n)] scale-0 delay-100 group-hover:scale-100 group-focus-visible:scale-100", chamferBox[corner]]}
              style={`background-image:linear-gradient(${chamferAxis[corner]}, transparent 50%, var(--color-flux-blue) 50%, var(--color-flux-blue) calc(50% + 2px), transparent calc(50% + 2px))`}
            />
            <span
              class:list={[accentBase, "h-8 w-[2px] scale-y-0 bg-flux-blue delay-200 group-hover:scale-y-100 group-focus-visible:scale-y-100", edgeY[corner]]}
            />
          </span>
        )
      }
    </div>
  </div>

  {
    label && (
      <figcaption
        class:list={[
          "fp-label pointer-events-none absolute inline-flex translate-y-2 items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--color-ink-line)] bg-ink-900/90 px-2.5 py-1 font-mono text-[0.62rem] font-medium uppercase tracking-[0.14em] text-ink-300 opacity-0 transition-[opacity,translate] duration-500 ease-[var(--ease-out-expo)] group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100",
          labelPos[corner],
        ]}
      >
        <span class="size-1 rounded-full bg-flux-blue" aria-hidden="true" />
        {label}
      </figcaption>
    )
  }
</figure>

<style>
  /* Single-corner chamfer, same `--n` family as NotchedPanel. */
  .fp-clip[data-corner="tl"] {
    clip-path: polygon(var(--n) 0, 100% 0, 100% 100%, 0 100%, 0 var(--n));
  }
  .fp-clip[data-corner="tr"] {
    clip-path: polygon(0 0, calc(100% - var(--n)) 0, 100% var(--n), 100% 100%, 0 100%);
  }
  .fp-clip[data-corner="bl"] {
    clip-path: polygon(0 0, 100% 0, 100% 100%, var(--n) 100%, 0 calc(100% - var(--n)));
  }
  .fp-clip[data-corner="br"] {
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--n)), calc(100% - var(--n)) 100%, 0 100%);
  }

  /* Hairline that follows the chamfer. `filter` runs before `clip-path` on the
     same element, so the outline is emitted by the clipped box's parent. */
  .fp-frame {
    filter:
      drop-shadow(-0.5px -0.5px 0 var(--color-ink-line))
      drop-shadow(0.5px -0.5px 0 var(--color-ink-line))
      drop-shadow(-0.5px 0.5px 0 var(--color-ink-line))
      drop-shadow(0.5px 0.5px 0 var(--color-ink-line))
      drop-shadow(3px 4px 6px rgba(32, 31, 30, 0.06));
  }

  /* Tailwind's `group-*` variants only fire when an ancestor carries `.group`.
     Mirror the hover state off an enclosing link/button's own focus so keyboard
     users get it even when the caller forgot to add `group` to the wrapper. */
  :global(a:focus-visible) .fp-img,
  :global(button:focus-visible) .fp-img {
    scale: 1.04;
    filter: contrast(1.02) saturate(1);
  }
  :global(a:focus-visible) .fp-veil,
  :global(button:focus-visible) .fp-veil {
    opacity: 0;
  }
  :global(a:focus-visible) .fp-accent,
  :global(button:focus-visible) .fp-accent {
    scale: 1;
  }
  :global(a:focus-visible) .fp-label,
  :global(button:focus-visible) .fp-label {
    translate: none;
    opacity: 1;
  }

  /* Tailwind v4 animates the discrete `scale` / `translate` properties, so the
     neutralisation has to reset those, not `transform`. */
  @media (prefers-reduced-motion: reduce) {
    .fp-img {
      scale: 1 !important;
    }
    .fp-accent {
      scale: 1 !important;
      transition-delay: 0ms !important;
    }
    .fp-label {
      translate: none !important;
      opacity: 1 !important;
    }
  }
</style>
