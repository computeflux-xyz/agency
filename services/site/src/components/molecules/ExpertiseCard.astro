---
/**
 * One practice on the /expertise hub.
 *
 * Six cards whose summaries all read as competent engineering are six identical
 * cards. What separates them for a visitor is the SYMPTOM each practice answers,
 * so `item.entryPoint` gets its own block under a hairline — the last thing read
 * before the link is followed.
 */
import Icon from "@atoms/Icon.astro";
import type { Expertise } from "@data/expertise";

interface Props {
  item: Expertise;
  href: string;
  cta: string;
  /** Localized lead-in for the symptom line, e.g. "Start here if". */
  startHere?: string;
  class?: string;
}
const { item, href, cta, startHere, class: className = "" } = Astro.props;

/* One glyph per practice, keyed by its ordinal — there are six practices and the
   icon set has to cover all of them, or 05 and 06 silently reuse 01 and 02. */
const ICONS: Record<string, string> = {
  "01": "spark", // AI engineering
  "02": "gauge", // inference
  "03": "bolt", // agentic systems
  "04": "layers", // data engineering
  "05": "cpu", // bare metal
  "06": "document", // sovereignty
};
const icon = ICONS[item.index] ?? "spark";
---

<a
  href={href}
  class:list={[
    "group relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-ink-line)] bg-surface p-7 transition-all duration-300 hover:border-ink-50 hover:shadow-[4px_6px_0_0_var(--color-ink-50)] hover:-translate-y-0.5",
    className,
  ]}
  data-reveal
>
  <div class="flex flex-col gap-5">
    <div class="flex items-center justify-between">
      <span class="font-mono text-xs tracking-widest text-ink-400">{item.index}</span>
      <span
        class="flex size-10 items-center justify-center rounded-[var(--radius-sm)] border border-[var(--color-ink-line)] text-ink-300 transition-colors group-hover:border-flux-blue group-hover:text-flux-blue"
      >
        <Icon name={icon} size={18} />
      </span>
    </div>
    <div class="flex flex-col gap-2.5">
      <h3 class="text-xl font-semibold tracking-tight text-ink-50">{item.title}</h3>
      <p class="text-pretty text-[0.95rem] leading-relaxed text-ink-300">{item.summary}</p>
    </div>

    {
      startHere && (
        <p class="flex flex-col gap-1.5 border-l border-[var(--color-ink-line)] pl-4 transition-colors group-hover:border-flux-blue">
          <span class="font-mono text-[0.62rem] font-medium uppercase tracking-[0.14em] text-ink-400">
            {startHere}
          </span>
          <span class="text-pretty text-[0.9rem] leading-relaxed text-ink-200">
            {item.entryPoint}
          </span>
        </p>
      )
    }
  </div>

  <div class="mt-7 flex items-center justify-end border-t border-[var(--color-ink-line)] pt-5">
    <span
      class="flex items-center gap-1.5 font-mono text-[0.7rem] font-medium uppercase tracking-wider text-ink-400 transition-colors group-hover:text-ink-50"
    >
      {cta}
      <Icon
        name="arrow"
        size={14}
        class="transition-transform duration-200 group-hover:translate-x-0.5"
      />
    </span>
  </div>
</a>
