---
import SectionHeader from "@molecules/SectionHeader.astro";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);

const steps = [
  { n: "01", title: t("approach.s1.title"), description: t("approach.s1.desc"), meta: t("approach.s1.meta") },
  { n: "02", title: t("approach.s2.title"), description: t("approach.s2.desc"), meta: t("approach.s2.meta") },
  { n: "03", title: t("approach.s3.title"), description: t("approach.s3.desc"), meta: t("approach.s3.meta") },
];
---

<section id="engagements" class="container-flux scroll-mt-24 py-20 md:py-28">
  <SectionHeader
    eyebrow={t("approach.eyebrow")}
    title={t("approach.title")}
    lead={t("approach.lead")}
    class="mb-14"
  />

  <ol class="flex flex-col border-t border-[var(--color-ink-line)]" data-reveal-stagger="90">
    {
      steps.map((step) => (
        <li
          class="grid grid-cols-1 gap-2 border-b border-[var(--color-ink-line)] py-8 md:grid-cols-[auto_1fr_auto] md:items-baseline md:gap-8"
          data-reveal
        >
          <div class="flex items-baseline gap-4 md:w-64">
            <span class="font-mono text-sm text-ink-400">{step.n}</span>
            <h3 class="text-xl font-semibold tracking-tight text-ink-50 md:text-2xl">{step.title}</h3>
          </div>
          <p class="text-pretty leading-relaxed text-ink-300">{step.description}</p>
          <span class="font-mono text-xs uppercase tracking-wider text-ink-400 md:text-right">{step.meta}</span>
        </li>
      ))
    }
  </ol>
</section>

