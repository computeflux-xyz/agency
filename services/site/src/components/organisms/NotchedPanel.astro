---

type Tone = "dark" | "surface" | "blue" | "magenta" | "amber" | "green";

interface Props {
  tone?: Tone;
  /** Solid background color (e.g. "#157493"). Overrides `tone`. Assumed dark:
   *  renders white text and a light-white dotted grid. Set `light` when the
   *  fill is pale. */
  bg?: string;
  /** The custom `bg` is a light colour, so render dark text and dark dots. */
  light?: boolean;
  notch?: number;
  shadow?: boolean;
  dotted?: boolean;
  /** Stretch the panel to the height of its container. Needed inside a grid or
   *  flex row of equal-height cards: without it the clipped shape keeps its
   *  content height while the offset shadow (`inset-0` on the stretched root)
   *  takes the full row height, and the two come apart. */
  fill?: boolean;
  class?: string;
}

const {
  tone = "dark",
  bg,
  light = false,
  notch = 34,
  shadow = true,
  dotted = true,
  fill = false,
  class: className = "",
} = Astro.props;

const tones: Record<Tone, string> = {
  dark: "bg-[var(--color-invert-bg)] text-ink-900",
  surface: "bg-surface text-ink-50",
  blue: "bg-flux-blue text-white",
  magenta: "bg-flux-magenta text-white",
  amber: "bg-flux-amber text-ink-50",
  green: "bg-[#1f7a5f] text-white",
};

const custom = typeof bg === "string" && bg.length > 0;
const customLight = custom && light;

// Dark dots on any pale surface (the `surface` tone, or a custom light fill);
// light-white dots on every dark fill.
const onLight = customLight || (!custom && tone === "surface");
const dotVar = onLight ? "var(--svg-dot)" : "var(--svg-dot-light)";
const dotOpacity = customLight ? "0.5" : custom ? "0.18" : tone === "surface" ? "0.6" : "0.14";
const customText = customLight ? "text-ink-50" : "text-white";
---

<div class:list={["notch-root relative", className]} style={`--n: clamp(16px, 3.2vw, ${notch}px)`}>
  {shadow && (
    <div class="notch-shape absolute inset-0 translate-x-[7px] translate-y-[9px] bg-ink-50" aria-hidden="true"></div>
  )}
  <div
    class:list={["notch-shape relative overflow-hidden", fill && "h-full", custom ? customText : tones[tone]]}
    style={custom ? `background-color:${bg}` : undefined}
  >
    {dotted && (
      <div
        class="pointer-events-none absolute inset-0"
        style={`background-image:${dotVar};opacity:${dotOpacity}`}
        aria-hidden="true"
      >
      </div>
    )}
    {/* `fill` has to be carried all the way down: a `h-full` child of the slot
        resolves against THIS wrapper, not against `.notch-shape`. */}
    <div class:list={["relative", fill && "h-full"]}><slot /></div>
  </div>
</div>

<style>
  .notch-shape {
    clip-path: polygon(
      var(--n) 0,
      calc(100% - var(--n)) 0,
      calc(100% - var(--n)) var(--n),
      100% var(--n),
      100% calc(100% - var(--n)),
      calc(100% - var(--n)) calc(100% - var(--n)),
      calc(100% - var(--n)) 100%,
      var(--n) 100%,
      var(--n) calc(100% - var(--n)),
      0 calc(100% - var(--n)),
      0 var(--n),
      var(--n) var(--n)
    );
  }
</style>
