---
/**
 * Landing hero.
 *
 * The two-person photograph sits in a NotchedPanel-shaped frame behind the
 * copy, with a light gradient over the text zone so the dark ink stays readable
 * however bright the photo is. Order on top of it: top line, title (one word
 * gradient-highlighted), description (brand name badge-inline), the two CTAs,
 * and a subrow about cloud vs bare metal.
 */
import Button from "@atoms/Button.astro";
import Highlight from "@atoms/Highlight.astro";
import { getLocale, localizedPath, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<section class="relative overflow-hidden pt-24 md:pt-32" aria-label="Introduction">
  <div class="container-flux flex flex-col items-center gap-7 text-center">
    <p class="eyebrow text-ink-50" data-reveal>{t("hero.top")}</p>

    <h1
      class="max-w-4xl text-balance text-[2.4rem] font-semibold leading-[1.05] tracking-tight sm:text-5xl md:text-[3.6rem]"
      data-reveal
    >
      <Highlight>Du silicon au dashboard</Highlight>,
      nous concevons votre plateforme de traitement de données.
    </h1>

    <p
      class="hero-copy-card dot-grid max-w-2xl rounded-[var(--radius-md)] border border-[var(--color-border-strong)]/70 bg-ink-900/85 px-6 py-5 text-left text-pretty text-base leading-relaxed text-ink-100 shadow-[0_6px_24px_rgba(32,31,30,0.10)] backdrop-blur sm:px-8 sm:text-lg"
      data-reveal
    >
      <Highlight logo>Computeflux</Highlight> est une agence française d'ingénierie data et IA.
      Nous vous aidons à concevoir des systèmes intelligents basés sur vos besoins les plus exotiques,
      qu'il s'agisse d'un prototypage ou du refactoring d'un système mature en production.
    </p>

    <div class="flex flex-col items-center gap-3 sm:flex-row" data-reveal>
      <Button href={localizedPath("/book", locale)} variant="primary" size="lg" arrow>{t("nav.bookCall")}</Button>
      <Button href="#practices" variant="secondary" size="lg">{t("hero.ctaExplore")}</Button>
    </div>

    <p
      class="hero-copy-card dot-grid max-w-2xl rounded-[var(--radius-md)] border border-[var(--color-border-strong)]/70 bg-ink-900/85 px-6 py-4 text-pretty text-sm leading-relaxed text-ink-200 shadow-[0_6px_24px_rgba(32,31,30,0.10)] backdrop-blur sm:px-8"
      data-reveal
    >
      {t("hero.subrow")}
    </p>
  </div>
</section>
