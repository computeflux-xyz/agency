---
/**
 * "Nos propres systèmes" — dogfooding, not social proof.
 *
 * Two product cards on contrasting solid backgrounds. Each carries the single
 * hard engineering decision behind it, a `MiniChart` that visualises the shape
 * of that difficulty, and two accent CTAs ("Voir le site" / "Code source") in
 * the same amber family as the rest of the site. Cards are equal height; the
 * footer link row is pinned to the bottom with `mt-auto`.
 */
import Button from "@atoms/Button.astro";
import Eyebrow from "@atoms/Eyebrow.astro";
import Highlight from "@atoms/Highlight.astro";
import MiniChart from "@atoms/MiniChart.astro";
import Tag from "@atoms/Tag.astro";
import { getSystems } from "@data/systems";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const systems = getSystems(locale);

/* Light lockups are wide (1200×421); coloured lockups moderate (680×152). */
const logoCls: Record<"mark" | "lockup", string> = {
  lockup: "h-9 w-auto object-contain object-left md:h-10",
  mark: "size-11 object-contain object-left",
};
---

<section id="systems" class="container-flux scroll-mt-24 py-20 md:py-28">
  <header class="mb-12 flex max-w-3xl flex-col gap-4 md:mb-16" data-reveal>
    <Eyebrow accent="amber">{t("systems.eyebrow")}</Eyebrow>
    <h2 class="text-balance text-3xl font-semibold leading-[1.05] sm:text-4xl md:text-[2.75rem]">
      {t("systems.title.a")} <Highlight>{t("systems.title.hl")}</Highlight>.
    </h2>
    <p class="max-w-2xl text-pretty text-base leading-relaxed text-ink-300 md:text-lg">
      <Highlight logo>{t("systems.subtitle.hl")}</Highlight> {t("systems.subtitle.rest")}
    </p>
  </header>

  <ul class="grid gap-6 md:grid-cols-2 md:gap-7" data-reveal-stagger="120">
    {
      systems.map((s) => (
        <li class="h-full" data-reveal>
          <div
            class="sys-card relative flex h-full flex-col gap-6 overflow-hidden p-7 md:p-9"
            style={`--n: clamp(16px, 3.2vw, 34px);background-color:${s.bg}`}
          >
            <div
              class="pointer-events-none absolute inset-0"
              style={"background-image:var(--svg-dot-light);opacity:0.12"}
              aria-hidden="true"
            ></div>

            <div
              class:list={[
                "relative flex flex-col gap-5",
                s.light ? "text-ink-50" : "text-[#fbfbf9]",
              ]}
            >
              <header class="flex flex-col gap-4">
                <img
                  src={s.logo}
                  alt={s.logoAlt}
                  loading="lazy"
                  decoding="async"
                  class:list={[logoCls[s.logoShape]]}
                />
                <span
                  class:list={[
                    "font-mono text-[0.66rem] uppercase tracking-[0.16em]",
                    s.light ? "text-ink-400" : "text-ink-500",
                  ]}
                >
                  {s.kind}
                </span>
              </header>

              <p
                class:list={["text-pretty text-lg leading-relaxed", s.light ? "text-ink-200" : "text-ink-600"]}
              >
                {s.what}
              </p>

              <MiniChart
                kind={s.chart.kind}
                data={s.chart.kind === "split"
                  ? { a: s.chart.data[0], b: s.chart.data[1], aLabel: s.chart.labels[0], bLabel: s.chart.labels[1] }
                  : s.chart.data}
                accent={s.light ? "var(--color-flux-magenta)" : "var(--color-flux-amber)"}
                good={s.light ? "var(--color-flux-blue)" : "var(--color-flux-amber)"}
                labelFill={s.light ? "var(--color-ink-400)" : "var(--color-ink-500)"}
                class="sys-chart"
              />

              <div class:list={["flex flex-col gap-2.5 border-t pt-6", s.light ? "border-ink-300/40" : "border-ink-300/25"]}>
                <Eyebrow accent={s.light ? "magenta" : "amber"} class:list={[s.light ? "text-ink-400" : "text-ink-500"]}>
                  {t("systems.hardLabel")}
                </Eyebrow>
                <p
                  class:list={["text-pretty leading-relaxed", s.light ? "text-ink-200" : "text-ink-600"]}
                >
                  {s.hard}
                </p>
              </div>

              <ul class="flex flex-wrap gap-2">
                {s.stack.map((item) => (
                  <li>
                    <Tag size="xs" class:list={[s.light ? "border-ink-300/40 bg-white/40 text-ink-300" : "border-ink-300/25 bg-white/5 text-ink-600"]}>
                      {item}
                    </Tag>
                  </li>
                ))}
              </ul>
            </div>

            <footer class:list={["relative mt-auto flex flex-wrap items-center gap-3 pt-2"]}>
              <Button href={s.url} target="_blank" rel="noopener" variant="primary" size="sm" arrow class:list={[s.light ? "" : ""]}>
                {t("systems.visit")}
              </Button>
              {s.sourceUrl && (
                <Button href={s.sourceUrl} target="_blank" rel="noopener" variant="outline" size="sm" onDark={!s.light}>
                  {t("systems.source")}
                </Button>
              )}
            </footer>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .sys-card { clip-path: polygon(var(--n) 0, calc(100% - var(--n)) 0, calc(100% - var(--n)) var(--n), 100% var(--n), 100% calc(100% - var(--n)), calc(100% - var(--n)) calc(100% - var(--n)), calc(100% - var(--n)) 100%, var(--n) 100%, var(--n) calc(100% - var(--n)), 0 calc(100% - var(--n)), 0 var(--n), var(--n) var(--n)); }
  .sys-chart { height: 96px; }
</style>
