---
/**
 * "Nos propres systèmes" — dogfooding, not social proof.
 *
 * Two product cards on contrasting solid backgrounds. Each carries the single
 * hard engineering decision behind it, a `SystemSketch` line drawing of what the
 * product actually does, and two accent CTAs ("Voir le site" / "Code source") in
 * the same amber family as the rest of the site. Cards are equal height; the
 * footer link row is pinned to the bottom with `mt-auto`.
 *
 * The frame is `NotchedPanel`, same as every other chamfered card on the site:
 * it owns the clip-path, the offset hard shadow, the dotted overlay and the
 * equal-height `fill` behaviour. FertiLuna's pale fill is why the panel grew a
 * `light` prop — a custom `bg` used to assume a dark colour and force white
 * text.
 *
 * One layout detail is deliberate: the logo/kind header and the CTA footer are
 * centred, so the two cards read as a matched pair despite one logo being a wide
 * lockup and the other compact. The prose between them stays left-aligned,
 * because centred body copy is hard to read.
 */
import Button from "@atoms/Button.astro";
import Eyebrow from "@atoms/Eyebrow.astro";
import Highlight from "@atoms/Highlight.astro";
import Collapsible from "@atoms/Collapsible.astro";
import NotchedPanel from "@organisms/NotchedPanel.astro";
import SectionHeader from "@molecules/SectionHeader.astro";
import SystemSketch from "@atoms/SystemSketch.astro";
import Tag from "@atoms/Tag.astro";
import { getSystems } from "@data/systems";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const systems = getSystems(locale);

/* Light lockups are wide (1200×421); coloured lockups moderate (680×152). */
const logoCls: Record<"mark" | "lockup", string> = {
  lockup: "h-9 w-auto object-contain object-center md:h-10",
  mark: "size-11 object-contain object-center",
};
---

<section id="systems" class="container-flux scroll-mt-24 py-20 md:py-28">
  <SectionHeader eyebrow={t("systems.eyebrow")} accent="amber" class="mb-12 md:mb-16">
    <Fragment slot="title">
      {t("systems.title.a")} <Highlight>{t("systems.title.hl")}</Highlight>.
    </Fragment>
    <Fragment slot="lead">
      <Highlight logo>{t("systems.subtitle.hl")}</Highlight> {t("systems.subtitle.rest")}
    </Fragment>
  </SectionHeader>

  <ul class="grid gap-6 md:grid-cols-2 md:gap-7" data-reveal-stagger="120">
    {
      systems.map((s) => (
        <li class="h-full" data-reveal>
          <NotchedPanel bg={s.bg} light={s.light} fill class="h-full">
          <div class="flex h-full flex-col gap-6 p-7 md:p-9">
            <div
              class:list={[
                "relative flex flex-col gap-5",
                s.light ? "text-ink-50" : "text-[#fbfbf9]",
              ]}
            >
              <header class="flex flex-col items-center gap-4 text-center">
                <img
                  src={s.logo}
                  alt={s.logoAlt}
                  loading="lazy"
                  decoding="async"
                  class:list={[logoCls[s.logoShape]]}
                />
                <span
                  class:list={[
                    "font-mono text-[0.66rem] uppercase tracking-[0.16em]",
                    s.light ? "text-ink-400" : "text-ink-500",
                  ]}
                >
                  {s.kind}
                </span>
              </header>

              <p
                class:list={["text-pretty text-lg leading-relaxed", s.light ? "text-ink-200" : "text-ink-600"]}
              >
                {s.what}
              </p>

              <SystemSketch
                name={s.sketch}
                caption={s.sketchCaption}
                class:list={[s.light ? "text-ink-200" : "text-ink-600"]}
              />

              <div class:list={["flex flex-col gap-2.5 border-t pt-6", s.light ? "border-ink-300/40" : "border-ink-300/25"]}>
                <Eyebrow accent={s.light ? "magenta" : "amber"} class:list={[s.light ? "text-ink-400" : "text-ink-500"]}>
                  {t("systems.hardLabel")}
                </Eyebrow>
                {/* The "what was hard" copy runs 210–285 characters, which is
                    ten to twelve stacked lines at 294px of measure and the main
                    reason each of these cards is ~1000px tall on a phone. The
                    text is kept in full; only the mobile preview is clamped. */}
                <Collapsible
                  lines={3}
                  class:list={["text-pretty leading-relaxed", s.light ? "text-ink-200" : "text-ink-600"]}
                >
                  {s.hard}
                </Collapsible>
              </div>

              <ul class="flex flex-wrap gap-2">
                {s.stack.map((item) => (
                  <li>
                    <Tag size="xs" class:list={[s.light ? "border-ink-300/40 bg-white/40 text-ink-300" : "border-ink-300/25 bg-white/5 text-ink-600"]}>
                      {item}
                    </Tag>
                  </li>
                ))}
              </ul>
            </div>

            <footer class:list={["relative mt-auto flex flex-wrap items-center justify-center gap-3 pt-2"]}>
              <Button href={s.url} target="_blank" rel="noopener" variant="primary" size="sm" arrow class:list={[s.light ? "" : ""]}>
                {t("systems.visit")}
              </Button>
              {s.sourceUrl && (
                <Button href={s.sourceUrl} target="_blank" rel="noopener" variant="outline" size="sm" onDark={!s.light}>
                  {t("systems.source")}
                </Button>
              )}
            </footer>
          </div>
          </NotchedPanel>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import Vivus from "vivus";

  /**
   * Sketch each system drawing once, when its card first scrolls into view.
   * Same options as the diagnostic diagrams: `oneByOne` draws path after path,
   * in the order the markup emits them, so the picture builds left to right.
   */
  function initSystemSketches() {
    const svgs = Array.from(document.querySelectorAll<SVGSVGElement>("#systems [data-sys-sketch]"));
    if (!svgs.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const seen = new WeakSet<SVGSVGElement>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const svg = entry.target as SVGSVGElement;
          if (!entry.isIntersecting || seen.has(svg)) continue;
          seen.add(svg);
          io.unobserve(svg);
          // vivus needs an id to key its internal state.
          if (!svg.id) svg.id = `sys-sketch-${Math.random().toString(36).slice(2, 9)}`;
          new Vivus(svg as unknown as HTMLElement, {
            type: "oneByOne",
            duration: 80,
            start: "autostart",
            animTimingFunction: Vivus.LINEAR,
            pathTimingFunction: Vivus.EASE_OUT,
          });
        }
      },
      { threshold: 0.35 },
    );

    svgs.forEach((svg) => io.observe(svg));
  }

  initSystemSketches();
  document.addEventListener("astro:page-load", initSystemSketches);
</script>
