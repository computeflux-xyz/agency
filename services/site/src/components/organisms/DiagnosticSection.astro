---
/**
 * DiagnosticSection — the N→P case browser.
 *
 * Ten cases, each a tab. A case is auto-selected every `DURATION` ms while a
 * progress fill runs across the active quadtree region; hovering the open card
 * pauses the fill; clicking a region selects it at once. On coarse-pointer
 * (touch) devices the auto-advance is disabled to stay predictable.
 *
 * Desktop layout: a one-line heading on top, then a two-column body — the
 * random quadtree on the LEFT (active case owns the biggest region, the top-left
 * ¼, with its tool icons and on-hover "why" popups), and the content card on
 * the RIGHT. The card is split in two halves: "what is usually going on" (with
 * a draw.io-style architecture diagram, animated with vivus on selection) on
 * top, and "what we do" (same treatment) on the bottom. All ten panels share one
 * grid cell and the inactive ones are `visibility:hidden`, so the frame never
 * jumps as selection moves.
 *
 * This component owns its own client script (the global ARIA `tabs.ts` has no
 * concept of a timer), but keeps the same ARIA contract (`role=tab` / tabpanel,
 * `aria-controls` / `aria-labelledby`).
 */
import Button from "@atoms/Button.astro";
import Eyebrow from "@atoms/Eyebrow.astro";
import TechMark from "@atoms/TechMark.astro";
import DiagnosticDiagram from "@atoms/DiagnosticDiagram.astro";
import NotchedPanel from "@organisms/NotchedPanel.astro";
import { getDiagnostics } from "@data/diagnostics";
import { actionDiagrams, causeDiagrams } from "@data/diagrams";
import { getLocale, localizedPath, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);

const cases = getDiagnostics(locale);
const bookHref = localizedPath("/book", locale);
const causeLabel = t("diag.causeLabel");
const actionLabel = t("diag.actionLabel");

const items = cases.map((c, i) => ({
  ...c,
  index: String(i + 1).padStart(2, "0"),
  tabId: `diag-tab-${i + 1}`,
  panelId: `diag-panel-${i + 1}`,
  href: `${bookHref}?sujet=${c.slug}`,
  causeDiagram: causeDiagrams[c.slug],
  actionDiagram: actionDiagrams[c.slug],
}));
---

<section
  id="diagnostic"
  class="container-flux scroll-mt-24 py-20 md:py-28"
  data-diag
  data-reveal-stagger="60"
>
  <div class="diag-layout">
    <header class="diag-head" data-reveal>
      <Eyebrow accent="blue">{t("diagHome.eyebrow")}</Eyebrow>
      <h2 class="diag-title">{t("diagHome.title")}</h2>
    </header>

    <div class="diag-body">
      {/* Random quadtree (left): a square split into recursive regions. The
          active case always owns the biggest region — the top-left quadrant
          (¼ of the area) — and the other cases fill the remaining L-shape
          through random recursive subdivision. Selecting a new main case
          re-computes the partition so every region morphs to its new place.
          The active region also carries the tools used to solve this case;
          each icon explains itself in a popup on hover. */}
      <div
        class="diag-quadtree"
        role="tablist"
        aria-label={t("diagHome.title")}
        data-diag-tabs
        data-reveal
      >
        {
          items.map((item, i) => (
            <button
              type="button"
              role="tab"
              id={item.tabId}
              aria-controls={item.panelId}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="qt-cell"
              data-diag-chip
            >
              <span class="qt-label" data-diag-label>{item.label}</span>
              <span class="qt-tools" data-diag-tools aria-hidden="true">
                {
                  item.tools.map((tool) => (
                    <span
                      class="qt-tool"
                      data-diag-tool
                      data-tool-name={tool.name}
                      role="img"
                      aria-label={tool.name}
                    >
                      <TechMark name={tool.name} si={tool.si} class="size-5" />
                      <span class="qt-tool-reason" hidden>{tool.reason}</span>
                    </span>
                  ))
                }
              </span>
              <span class="qt-fill" data-diag-fill aria-hidden="true"><span class="qt-fill-bar"></span></span>
            </button>
          ))
        }
      </div>

      {/* Content card (right): cause on the top half, action on the bottom.
          Dark blue fill — same panel as "Un système à faire tenir en production ?".
          On desktop `.diag-panel-frame` is absolutely positioned, so the card
          contributes no intrinsic height and the grid row is sized by the
          quadtree alone: the card ends up exactly as tall as the square. */}
      <div class="diag-panel-area" data-diag-panel-area data-reveal>
        <div class="diag-panel-frame">
          <NotchedPanel bg="#157493" fill class="h-full w-full">
            <div class="diag-stack p-4 sm:p-5 lg:px-6 lg:py-5">
              {
                items.map((item, i) => (
                  <div
                    role="tabpanel"
                    id={item.panelId}
                    aria-labelledby={item.tabId}
                    class:list={["diag-panel", i === 0 && "is-active"]}
                    data-diag-panel={item.slug}
                  >
                    <section class="diag-half diag-half--cause">
                      <h3 class="diag-half-title eyebrow">{causeLabel}</h3>
                      <div class="diag-diagram-wrap">
                        {
                          item.causeDiagram && (
                            <DiagnosticDiagram
                              diagram={item.causeDiagram}
                              slug={item.slug}
                              kind="cause"
                            />
                          )
                        }
                      </div>
                      <p class="diag-text text-pretty">{item.cause}</p>
                    </section>

                    <section class="diag-half diag-half--action">
                      <h3 class="diag-half-title eyebrow">{actionLabel}</h3>
                      <div class="diag-diagram-wrap">
                        {
                          item.actionDiagram && (
                            <DiagnosticDiagram
                              diagram={item.actionDiagram}
                              slug={item.slug}
                              kind="action"
                            />
                          )
                        }
                      </div>
                      <p class="diag-text text-pretty">{item.action}</p>
                    </section>

                    <footer class="diag-cta flex flex-wrap items-center gap-4">
                      <Button href={item.href} variant="primary" arrow size="sm">{item.cta}</Button>
                      <a
                        href={localizedPath(item.morePath, locale)}
                        class="diag-more font-mono text-[0.72rem] font-medium uppercase tracking-wider transition-colors"
                      >
                        {t("diagHome.more")} →
                      </a>
                    </footer>
                  </div>
                ))
              }
            </div>
          </NotchedPanel>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .diag-stack { display: grid; height: 100%; min-height: 0; }
  .diag-panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    translate: 0 8px;
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 0.7rem;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    transition:
      opacity 0.35s var(--ease-out-expo),
      translate 0.35s var(--ease-out-expo),
      visibility 0.35s;
  }
  .diag-panel.is-active {
    visibility: visible;
    opacity: 1;
    translate: none;
  }

  /* ---- section: one-line heading, then quadtree (left) + card (right) ---- */
  .diag-layout {
    display: grid;
    gap: 2.5rem;
  }
  .diag-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
  }
  .diag-title {
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .diag-title { white-space: nowrap; }
  }

  .diag-body {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .diag-body {
      grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
      column-gap: clamp(1.75rem, 4vw, 3.5rem);
      align-items: stretch;
    }
    /* Take the card out of the flow so the row height comes from the square
       quadtree only — the card then matches it exactly, whatever it holds. */
    .diag-panel-frame {
      position: absolute;
      inset: 0;
    }
  }
  .diag-panel-area {
    position: relative;
    min-width: 0;
  }

  /* ---- the quadtree container: a fixed square, exactly as designed ---- */
  .diag-quadtree {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 30rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-ink-line);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: 0 1px 0 var(--color-ink-line) inset;
  }

  /* ---- one region (a leaf of the quadtree) ---- */
  .qt-cell {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.4rem;
    padding: clamp(0.4rem, 1.6vw, 0.8rem);
    border: 1px solid var(--color-ink-line);
    background: var(--color-surface-raised);
    color: var(--color-ink-400);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    opacity: 0;
    transition:
      left 0.75s var(--ease-out-expo),
      top 0.75s var(--ease-out-expo),
      width 0.75s var(--ease-out-expo),
      height 0.75s var(--ease-out-expo),
      border-color 0.3s,
      background 0.3s,
      color 0.3s,
      opacity 0.6s;
  }
  .diag-quadtree.is-ready .qt-cell { opacity: 1; }

  /* hover: the region lifts and highlights; the pointer stays a hand
     (buttons default to `default`, so it must be asked for) */
  .qt-cell:hover {
    z-index: 2;
    border-color: var(--color-border-strong);
    background: var(--color-ink-800);
    color: var(--color-ink-50);
    box-shadow:
      0 10px 24px -12px var(--color-border),
      -1px 0 0 var(--color-ink-line),
      0 -1px 0 var(--color-ink-line),
      1px 0 0 var(--color-ink-line);
  }

  /* the active case: the biggest (top-left ¼) region, amber */
  .qt-cell[aria-selected="true"] {
    border-color: var(--color-flux-amber);
    background: var(--color-flux-amber);
    color: var(--color-ink-50);
  }

  .qt-label {
    font-size: clamp(0.62rem, 1.5vw, 0.85rem);
    font-weight: 500;
    line-height: 1.2;
    color: inherit;
    overflow-wrap: anywhere;
  }
  /* the active region's text is the hero of the square: bigger and bolder */
  .qt-cell[aria-selected="true"] .qt-label {
    font-size: clamp(0.95rem, 2vw, 1.25rem);
    font-weight: 600;
    line-height: 1.12;
  }

  /* timer fill along the bottom edge of the active region */
  .qt-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(0, 0, 0, 0.16);
  }
  .qt-fill-bar {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-invert-bg);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* ---- tool icons: only the active (biggest) region shows its tools ---- */
  .qt-tools {
    display: none;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .qt-cell[aria-selected="true"] .qt-tools { display: flex; }
  .qt-tool {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--color-ink-50) 22%, transparent);
    background: color-mix(in srgb, var(--color-ink-50) 10%, transparent);
    color: var(--color-ink-100);
    cursor: help;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s var(--ease-out-expo),
      border-color 0.2s;
  }
  .qt-tool:hover {
    background: var(--color-ink-50);
    color: var(--color-surface);
    border-color: var(--color-ink-50);
    transform: translateY(-2px);
  }
  /* Monogram marks (no Simple Icons glyph) hard-code a dark ink; flip them on
     the dark hover so the text stays readable. */
  .qt-tool:hover > span[aria-label] {
    color: var(--color-surface);
  }

  /* ---- content card: dark blue panel, two stacked halves ---- */
  .diag-half {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.4rem;
    min-height: 0;
  }
  .diag-half--action {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: 0.6rem;
  }
  /* half titles: white, centered, no bullet */
  .diag-half-title {
    display: block;
    width: 100%;
    text-align: center;
    color: #fff;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    margin: 0;
  }
  /* the diagram takes whatever height is left in its half and stays centered */
  .diag-diagram-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
  }
  .diag-text {
    font-size: clamp(0.78rem, 0.9vw, 0.86rem);
    line-height: 1.45;
    margin: 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.88);
  }
  .diag-half--action .diag-text { color: #fff; }
  /* CTA centered at the bottom */
  .diag-cta {
    justify-content: center;
    text-align: center;
    width: 100%;
  }
  .diag-more { color: rgba(255, 255, 255, 0.72); }
  .diag-more:hover { color: var(--color-flux-amber); }

  @media (prefers-reduced-motion: reduce) {
    .diag-panel { translate: none !important; transition: none !important; }
    .qt-cell { transition: none !important; }
    .qt-fill-bar { transition: none !important; }
  }
</style>

<style is:global>
  /* Tool popup (appended to <body>, so it must escape the scoped styles). */
  .qt-tooltip {
    position: fixed;
    z-index: 60;
    max-width: min(18rem, calc(100vw - 2rem));
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-invert-bg);
    color: var(--color-ink-900);
    box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.45);
    pointer-events: none;
    opacity: 0;
    translate: 0 4px;
    transition: opacity 0.18s, translate 0.18s var(--ease-out-expo);
  }
  .qt-tooltip.is-visible {
    opacity: 1;
    translate: 0 0;
  }
  .qt-tooltip-name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-flux-amber);
  }
  .qt-tooltip-reason {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-ink-800);
  }
  @media (prefers-reduced-motion: reduce) {
    .qt-tooltip { transition: none !important; }
  }
</style>

<script>
  import Vivus from "vivus";

  const DURATION = 10000;

  function initDiag(rootEl: HTMLElement) {
    if (rootEl.dataset.diagReady === "1") return;
    rootEl.dataset.diagReady = "1";

    const tablist = rootEl.querySelector<HTMLElement>("[data-diag-tabs]");
    if (!tablist) return;
    const tabs: HTMLElement = tablist;
    const chips = Array.from(tablist.querySelectorAll<HTMLElement>("[data-diag-chip]"));
    const panels = Array.from(rootEl.querySelectorAll<HTMLElement>("[data-diag-panel]"));
    if (!chips.length) return;

    const isCoarse = window.matchMedia("(pointer: coarse)").matches;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---- random quadtree layout engine ---- */
    type Rect = { x: number; y: number; w: number; h: number };

    // Deterministic PRNG seeded per active index: each case owns a stable-but-
    // distinct partition, so switching actives morphs every region to a new
    // place instead of reshuffling into noise.
    function rng(seed: number) {
      let a = seed >>> 0;
      return () => {
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // Split `n` indistinguishable items across `c` buckets, each >= 1.
    function allocate(n: number, c: number, rand: () => number): number[] {
      const out = new Array<number>(c).fill(1);
      let rest = n - c;
      while (rest-- > 0) out[Math.floor(rand() * c)]++;
      return out;
    }

    // Split a rectangle into two (random ratio along the longer axis) or a 2x2.
    function splitRects(rect: Rect, c: number, rand: () => number): Rect[] {
      if (c === 2) {
        if (rect.w >= rect.h) {
          const t = 0.32 + rand() * 0.36;
          return [
            { x: rect.x, y: rect.y, w: rect.w * t, h: rect.h },
            { x: rect.x + rect.w * t, y: rect.y, w: rect.w * (1 - t), h: rect.h },
          ];
        }
        const t = 0.32 + rand() * 0.36;
        return [
          { x: rect.x, y: rect.y, w: rect.w, h: rect.h * t },
          { x: rect.x, y: rect.y + rect.h * t, w: rect.w, h: rect.h * (1 - t) },
        ];
      }
      const hw = rect.w / 2;
      const hh = rect.h / 2;
      return [
        { x: rect.x, y: rect.y, w: hw, h: hh },
        { x: rect.x + hw, y: rect.y, w: hw, h: hh },
        { x: rect.x, y: rect.y + hh, w: hw, h: hh },
        { x: rect.x + hw, y: rect.y + hh, w: hw, h: hh },
      ];
    }

    // Recursively partition a rectangle into exactly `k` leaves.
    function subdiv(rect: Rect, k: number, rand: () => number): Rect[] {
      if (k <= 1) return [{ ...rect }];
      const c = k >= 4 && rand() < 0.7 ? 4 : 2;
      const counts = allocate(k, c, rand);
      const rs = splitRects(rect, c, rand);
      let out: Rect[] = [];
      for (let i = 0; i < c; i++) out = out.concat(subdiv(rs[i], counts[i], rand));
      return out;
    }

    // Build the full treemap: the active case always gets the top-left quadrant
    // (¼ of the area — the single biggest region), the rest fill the L-shape.
    function buildLayout(active: number, count: number): Rect[] {
      const rand = rng((active + 1) * 7919);
      const rects: (Rect | undefined)[] = new Array(count);
      rects[active] = { x: 0, y: 0, w: 0.5, h: 0.5 }; // top-left ¼

      const squares: Rect[] = [
        { x: 0.5, y: 0, w: 0.5, h: 0.5 },   // NE
        { x: 0, y: 0.5, w: 0.5, h: 0.5 },   // SW
        { x: 0.5, y: 0.5, w: 0.5, h: 0.5 }, // SE
      ];
      const counts = allocate(count - 1, 3, rand);
      let k = 0;
      for (let s = 0; s < 3; s++) {
        const leaves = subdiv(squares[s], counts[s], rand);
        for (const r of leaves) {
          while (rects[k] !== undefined) k++; // find next free slot
          rects[k] = r;
          k++;
        }
      }
      return rects.map((r) => r as Rect);
    }

    let idx = 0;
    // The gauge runs only when the section is on screen and the card is not
    // hovered — an off-screen carousel would burn frames and, worse, replay the
    // sketch animations nobody is looking at.
    let onScreen = true;
    let hovered = false;
    const timerOn = () => !isCoarse && !reduce && onScreen && !hovered;
    let progress = 0;

    const fillBar = (chip: HTMLElement) => chip.querySelector<HTMLElement>("[data-diag-fill] .qt-fill-bar");
    const bars = chips.map((c) => fillBar(c));

    // ---- tool popups: "why we reach for this tool" on the active region ----
    let tooltipEl: HTMLElement | null = document.querySelector<HTMLElement>(".qt-tooltip");
    const ensureTooltip = (): HTMLElement => {
      if (tooltipEl && document.body.contains(tooltipEl)) return tooltipEl;
      tooltipEl = document.createElement("div");
      tooltipEl.className = "qt-tooltip";
      tooltipEl.setAttribute("role", "tooltip");
      tooltipEl.innerHTML =
        '<span class="qt-tooltip-name"></span>' + '<span class="qt-tooltip-reason"></span>';
      document.body.appendChild(tooltipEl);
      return tooltipEl;
    };
    const tooltip = ensureTooltip();
    const tipName = tooltip.querySelector<HTMLElement>(".qt-tooltip-name");
    const tipReason = tooltip.querySelector<HTMLElement>(".qt-tooltip-reason");

    const positionTooltip = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const tw = tooltip.offsetWidth;
      const th = tooltip.offsetHeight;
      let x = r.left + r.width / 2 - tw / 2;
      x = Math.max(10, Math.min(x, window.innerWidth - tw - 10));
      let y = r.top - th - 10;
      if (y < 10) y = r.bottom + 10;
      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
    };

    const showTip = (el: HTMLElement) => {
      if (!tipName || !tipReason) return;
      tipName.textContent = el.dataset.toolName ?? "";
      tipReason.textContent = el.querySelector<HTMLElement>(".qt-tool-reason")?.textContent?.trim() ?? "";
      tooltip.classList.add("is-visible");
      positionTooltip(el);
    };
    const hideTip = () => tooltip.classList.remove("is-visible");

    rootEl.querySelectorAll<HTMLElement>("[data-diag-tool]").forEach((el) => {
      el.addEventListener("pointerenter", () => showTip(el));
      el.addEventListener("pointerleave", hideTip);
      el.addEventListener("pointermove", () => {
        if (tooltip.classList.contains("is-visible")) positionTooltip(el);
      });
    });

    // ---- vivus: sketch the architecture diagrams of the case that opens ----
    // `oneByOne` draws one path after the other (node, edge, node, ...) so the
    // graph appears the way you would draw it on a whiteboard. `is-drawing`
    // holds the node fills and the labels back until the outline is done.
    const vivusMap = new Map<string, Vivus>();
    function animateDiagrams(index: number) {
      const panel = panels[index];
      if (!panel) return;
      panel.querySelectorAll<SVGSVGElement>("[data-diag-diagram]").forEach((svg) => {
        if (reduce) {
          svg.classList.remove("is-drawing");
          return;
        }
        let v = vivusMap.get(svg.id);
        if (!v) {
          v = new Vivus(svg as unknown as HTMLElement, {
            type: "oneByOne",
            duration: 130,
            start: "manual",
            animTimingFunction: Vivus.LINEAR,
            pathTimingFunction: Vivus.EASE_OUT,
          });
          vivusMap.set(svg.id, v);
        }
        v.stop();
        v.reset();
        svg.classList.add("is-drawing");
        v.play(1, () => svg.classList.remove("is-drawing"));
      });
    }

    function applyLayout() {
      const rects = buildLayout(idx, chips.length);
      chips.forEach((c, i) => {
        const r = rects[i];
        c.style.left = `${r.x * 100}%`;
        c.style.top = `${r.y * 100}%`;
        c.style.width = `${r.w * 100}%`;
        c.style.height = `${r.h * 100}%`;
      });
      if (!tabs.classList.contains("is-ready")) {
        // reveal the regions only once they are placed (fade-in, no jump)
        requestAnimationFrame(() => tabs.classList.add("is-ready"));
      }
    }

    function updateFill() {
      bars.forEach((bar, i) => {
        if (!bar) return;
        bar.style.transform = `scaleX(${i === idx ? progress : 0})`;
      });
    }

    function announce(index: number, focus: boolean) {
      chips.forEach((c, i) => {
        const sel = i === index;
        c.setAttribute("aria-selected", String(sel));
        c.setAttribute("tabindex", sel ? "0" : "-1");
        panels[i]?.classList.toggle("is-active", sel);
      });
      if (focus) chips[index]?.focus();
    }

    // Open a case: re-partition the quadtree, swap the card, sketch its
    // diagrams from scratch and restart the gauge.
    const open = (index: number, focus: boolean) => {
      idx = index;
      progress = 0;
      applyLayout();
      announce(idx, focus);
      animateDiagrams(idx);
      updateFill();

      // Reconcile the hover-pause: the selection may have just changed under a
      // stationary pointer (no pointerover fired), so check where the pointer
      // actually is and pause accordingly.
      if (lastPointer.x >= 0) {
        const el = document.elementFromPoint(lastPointer.x, lastPointer.y);
        const chip = el instanceof Element ? el.closest<HTMLElement>("[data-diag-chip]") : null;
        const nowOver = chip ? chip === chips[index] : Boolean(el?.closest("[data-diag-panel-area]"));
        if (nowOver !== overActive) {
          overActive = nowOver;
          if (nowOver) pause();
          else resume();
        }
      }
    };
    const select = (index: number, focus = false) => {
      if (index === idx) return;
      open(index, focus);
    };

    let last = performance.now();
    function tick(now: number) {
      const dt = Math.min(now - last, 200); // clamp: tab was in the background
      last = now;
      if (timerOn()) {
        progress += dt / DURATION;
        if (progress >= 1) open((idx + 1) % chips.length, false);
        updateFill();
      }
      requestAnimationFrame(tick);
    }

    chips.forEach((c, i) => {
      c.addEventListener("click", () => { select(i, false); });
    });
    tabs.addEventListener("keydown", (e) => {
      let next: number;
      switch (e.key) {
        case "ArrowRight": next = (idx + 1) % chips.length; break;
        case "ArrowLeft": next = (idx - 1 + chips.length) % chips.length; break;
        case "Home": next = 0; break;
        case "End": next = chips.length - 1; break;
        default: return;
      }
      e.preventDefault();
      select(next, true);
    });

    /* Pause the gauge while the pointer rests on the ACTIVE region of the
       quadtree or on the open card. `pointerover` bubbles, so one listener on
       the whole section covers both zones. We also keep the last pointer
       position so a selection change that happens under a stationary pointer
       can be reconciled right inside `open`. */
    const panelArea = rootEl.querySelector<HTMLElement>("[data-diag-panel-area]");
    const pause = () => { hovered = true; };
    const resume = () => { hovered = false; last = performance.now(); };

    let overActive = false;
    let lastPointer = { x: -1, y: -1 };
    const onPauseHover = (e: PointerEvent) => {
      lastPointer.x = e.clientX;
      lastPointer.y = e.clientY;
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      const chip = el.closest<HTMLElement>("[data-diag-chip]");
      const nowOver = chip ? chip === chips[idx] : Boolean(el.closest("[data-diag-panel-area]"));
      if (nowOver === overActive) return;
      overActive = nowOver;
      if (nowOver) pause();
      else resume();
    };
    if (!isCoarse) rootEl.addEventListener("pointerover", onPauseHover);

    if (panelArea && !isCoarse) {
      // Touch: pause while touching the card (touch laptops with a fine pointer).
      panelArea.addEventListener("touchstart", pause, { passive: true });
      panelArea.addEventListener("touchend", resume, { passive: true });
    }

    // Initial placement, then start the timer loop.
    applyLayout();
    announce(0, false);
    updateFill();
    requestAnimationFrame(tick);

    /* The first card only sketches itself once the section is actually in view
       (and it sketches again on every return), so the animation is never spent
       above the fold. */
    if ("IntersectionObserver" in window) {
      onScreen = false;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const was = onScreen;
            onScreen = entry.isIntersecting;
            if (onScreen && !was) {
              progress = 0;
              last = performance.now();
              animateDiagrams(idx);
              updateFill();
            }
          }
        },
        { threshold: 0.2 },
      );
      io.observe(rootEl);
    } else {
      animateDiagrams(0);
    }
  }

  const root = document.querySelector<HTMLElement>("[data-diag]");
  if (root) initDiag(root);
  document.addEventListener("astro:after-swap", () => {
    const el = document.querySelector<HTMLElement>("[data-diag]");
    if (el) initDiag(el);
  });
</script>
