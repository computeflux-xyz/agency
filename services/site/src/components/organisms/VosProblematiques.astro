---
/**
 * "Vos problématiques" — a sticky deck.
 *
 * Rather than a page that keeps growing, the six problems are dealt like a desk
 * of cards: each is `position: sticky` with a slightly larger inset, so as you
 * scroll the next card slides up over the previous one — the page keeps its
 * weight, the cards reveal themselves. No JS: it is pure CSS sticky stacking.
 */
import Button from "@atoms/Button.astro";
import Eyebrow from "@atoms/Eyebrow.astro";
import SectionHeader from "@molecules/SectionHeader.astro";
import { getProblems } from "@data/problems";
import { getLocale, localizedPath, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const problems = getProblems(locale);

const accents = ["blue", "magenta", "amber", "blue", "magenta", "amber"];
const accentBg: Record<string, string> = {
  blue: "bg-flux-blue",
  magenta: "bg-flux-magenta",
  amber: "bg-flux-amber",
};
const bookHref = localizedPath("/book", locale);
---

<section
  id="problematiques"
  class="container-flux scroll-mt-24"
  data-analytics-section="problems"
  data-analytics-view="problems"
>
  <SectionHeader
    eyebrow={t("vostro.eyebrow")}
    title={t("vostro.title")}
    lead={t("vostro.sub")}
    class="mb-12 md:mb-16"
  />

  <div class="deck">
    {
      problems.map((p, i) => (
        <div
          class="deck-card"
          style={`--i:${i}`}
          data-reveal
        >
          <article class="notched-deck relative flex flex-col gap-4 p-7 md:flex-row md:items-center md:gap-10 md:p-10">
            <span
              class:list={[
                "absolute left-0 top-0 h-full w-1.5",
                accentBg[accents[i % accents.length]],
              ]}
              aria-hidden="true"
            ></span>
            <span class="font-mono text-sm text-ink-400" aria-hidden="true">{p.n}</span>
            <div class="flex min-w-0 flex-1 flex-col gap-2">
              <span class="inline-flex w-fit items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--color-ink-line)] px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-ink-400">
                {p.tag}
              </span>
              <h3 class="text-balance text-xl font-semibold tracking-tight text-ink-50 md:text-2xl">
                {p.title}
              </h3>
              <p class="max-w-2xl text-pretty leading-relaxed text-ink-300">{p.body}</p>
            </div>
            <div class="shrink-0">
              <Button
                href={p.booking ? bookHref : localizedPath(p.href, locale)}
                variant="primary"
                size="sm"
                arrow
              >
                {t("vostro.cta")}
              </Button>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* The `.deck-card` is a pure layout wrapper: it owns only the sticky
     positioning that deals the cards. All surface/border/shadow live on the
     clipped `.notched-deck` below — a filter here would create a containing
     block and break the sticky stack. */
  .deck {
    position: relative;
    /* Tracks the header, which is `h-16` (64px) until `md` and `4.5rem` (72px)
       after. A flat 5.25rem left the pinned deck floating 20px below the bar it
       is supposed to tuck under on every phone. */
    --deck-top: 4.75rem;
    --deck-step: 1.1rem;
    /* The deck is the sticky containing block, so its bottom edge is where the
       cards let go. Without a tail the last card reaches its offset at the exact
       moment its bottom hits that edge — it pins for zero scroll and the
       assembled deck is never actually seen. This holds it for a beat. */
    padding-bottom: clamp(4rem, 18vh, 10rem);
  }

  /* Each card pins one step lower than the one before, so a pinned card leaves a
     sliver of its predecessor showing — that is the deck.

     Deliberately no negative margins here. Sticky containment clamps an element
     by its MARGIN box, so a negative bottom margin buys it exactly that much
     travel past the deck's bottom edge. With a per-index margin every card
     overshot by a different amount and the second-to-last one parked below the
     last, poking out from under the stack. Uniform heights and strictly
     increasing offsets make the stack correct by construction instead. */
  .deck-card {
    position: sticky;
    top: calc(var(--deck-top) + var(--i) * var(--deck-step));
  }

  /* Chamfered technical card (Tenstorrent motif, same as `.notched`): the
     background, the hairline and the shadow all sit on the clipped element so
     the silhouette stays coherent. The hairline is four 0.5px corner offsets
     that trace the chamfer; the last layer is the article cards' signature
     hard ink offset — drawn with drop-shadow (not box-shadow, which a
     clip-path would cut away) so it follows the notch instead of a plain box. */
  .notched-deck {
    background: var(--color-surface);
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
    filter:
      drop-shadow(-0.5px -0.5px 0 var(--color-ink-line))
      drop-shadow(0.5px -0.5px 0 var(--color-ink-line))
      drop-shadow(-0.5px 0.5px 0 var(--color-ink-line))
      drop-shadow(0.5px 0.5px 0 var(--color-ink-line))
      drop-shadow(4px 6px 0 var(--color-ink-50));
  }
  @media (min-width: 768px) {
    .deck { --deck-top: 5.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .deck-card { top: var(--deck-top); }
  }
</style>
