---
import Button from "@atoms/Button.astro";
import NotchedPanel from "@organisms/NotchedPanel.astro";
import { getLocale, localizedPath, useTranslations } from "@i18n";

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  class?: string;
}
const { eyebrow, title, lead, class: className = "" } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const eyebrowText = eyebrow ?? t("cta.eyebrow");
const titleText = title ?? t("cta.title");
const leadText = lead ?? t("cta.lead");
const bookHref = localizedPath("/book", locale);
const studiesHref = localizedPath("/studies", locale);
---

<section class:list={["container-flux py-20 md:py-28", className]}>
  <NotchedPanel bg="#157493" data-reveal>
    <div class="relative px-6 py-14 md:px-16 md:py-20">
      <div
        class="pointer-events-none absolute -right-20 -top-20 size-72 rounded-full bg-flux-magenta/25 blur-[100px]"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-24 -left-20 size-72 rounded-full bg-flux-blue/25 blur-[100px]"
        aria-hidden="true"
      >
      </div>

      <div class="relative flex flex-col items-start gap-6 md:max-w-2xl">
        <span class="flex items-center gap-2 font-mono text-[0.72rem] font-medium uppercase tracking-[0.14em] text-flux-amber">
          <span class="size-1.5 rounded-full bg-flux-amber" aria-hidden="true"></span>
          {eyebrowText}
        </span>
        <h2 class="text-balance text-3xl font-semibold leading-[1.05] tracking-tight text-[#fbfbf9] sm:text-4xl md:text-5xl">
          {titleText}
        </h2>
        {/* `text-ink-500` (#9c9686) on the #157493 fill is about 2.2:1 — it
            fails contrast outright, and a phone screen outdoors is where that
            shows first. Matches the body copy on the other dark panels. */}
        <p class="text-pretty text-lg leading-relaxed text-white/[0.88]">{leadText}</p>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <Button href={bookHref} variant="primary" size="lg" arrow>{t("nav.bookCall")}</Button>
          <Button href={studiesHref} variant="outline" size="lg" onDark>{t("cta.studies")}</Button>
        </div>
      </div>
    </div>
  </NotchedPanel>
</section>
