---
// Server-rendered case-study index, locale-aware. Reads the active locale from
// the URL, requests that language from site-api (falling back to the bundled
// content collection when the API is unreachable), and keeps every link inside
// the locale. Rendered by both /studies (fr) and /en/studies.
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import CtaSection from "@organisms/CtaSection.astro";
import ArticleCard from "@molecules/ArticleCard.astro";
import Divider from "@atoms/Divider.astro";
import Icon from "@atoms/Icon.astro";
import { readingTime, slugify } from "@lib/utils";
import { site } from "@lib/site";
import { createApiClient, type ArticleType, type Topic } from "@lib/api";
import { localeFromPath, localizedPath, useTranslations } from "@i18n";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const title = t("studies.title");
const description = t("studies.metaDescription");
const studiesPath = localizedPath("/studies", locale);

const PAGE_SIZE = 6;
const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim();
const activeTopic = params.get("topic") ?? "";
const page = Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1);

type Card = {
  href: string;
  title: string;
  description: string;
  topics: string[];
  date: string;
  readingTime: number;
  cover?: string | null;
  featured: boolean;
};

const runtimeEnv = (Astro.locals as { runtime?: { env?: Record<string, string> } })?.runtime?.env;
const apiBaseUrl = runtimeEnv?.API_BASE_URL ?? import.meta.env.API_BASE_URL;

let cards: Card[] = [];
let topics: Topic[] = [];
let total = 0;
let source: "api" | "content" = "content";

if (apiBaseUrl) {
  try {
    const api = createApiClient({ baseUrl: apiBaseUrl, lang: locale });
    // `listTopics` counts across every content type, so filtering it by
    // articleCount would offer chips that match zero studies. The second call
    // is an unfiltered study listing used only to derive the chip set.
    const [list, allStudies] = await Promise.all([
      api.listArticles({
        types: ["study"] as ArticleType[],
        topics: activeTopic ? [activeTopic] : undefined,
        search: q || undefined,
        sort: "featured",
        page,
        pageSize: PAGE_SIZE,
      }),
      api.listArticles({
        types: ["study"] as ArticleType[],
        sort: "featured",
        page: 1,
        pageSize: 100,
      }),
    ]);
    total = list.total;
    cards = list.items.map((a) => ({
      href: localizedPath(`/studies/${a.slug}`, locale),
      title: a.title,
      description: a.shortdesc,
      topics: a.topics.map((tp) => tp.name),
      date: a.datePublished,
      readingTime: a.readingTime,
      cover: a.coverImage,
      featured: a.featured,
    }));
    const seen = new Map<string, Topic>();
    for (const study of allStudies.items) {
      for (const tp of study.topics) {
        const entry = seen.get(tp.slug);
        if (entry) entry.articleCount = (entry.articleCount ?? 0) + 1;
        else seen.set(tp.slug, { ...tp, articleCount: 1 });
      }
    }
    topics = [...seen.values()].sort((a, b) => a.name.localeCompare(b.name));
    source = "api";
  } catch {
    source = "content";
  }
}

if (source === "content") {
  const entries = (await getCollection("studies", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const filtered = entries.filter(
    (e) =>
      (!activeTopic || e.data.topics.map(slugify).includes(activeTopic)) &&
      (!q || `${e.data.title} ${e.data.description}`.toLowerCase().includes(q.toLowerCase())),
  );
  total = filtered.length;
  cards = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map((e) => ({
    href: localizedPath(`/studies/${e.id}`, locale),
    title: e.data.title,
    description: e.data.description,
    topics: e.data.topics,
    date: e.data.publishDate.toISOString(),
    readingTime: readingTime(e.body ?? ""),
    cover: e.data.cover ?? null,
    featured: e.data.featured,
  }));
  const set = new Map<string, string>();
  entries.forEach((e) => e.data.topics.forEach((tp) => set.set(slugify(tp), tp)));
  topics = [...set].map(([slug, name]) => ({ name, slug }));
}

const activeTopicLabel = topics.find((tp) => tp.slug === activeTopic)?.name ?? activeTopic;
const hasFilters = Boolean(q || activeTopic);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

function buildUrl(overrides: { topic?: string | null; q?: string | null; page?: number | null }): string {
  const p = new URLSearchParams();
  const topic = overrides.topic !== undefined ? overrides.topic : activeTopic;
  const query = overrides.q !== undefined ? overrides.q : q;
  const pg = overrides.page !== undefined ? overrides.page : page;
  if (topic) p.set("topic", topic);
  if (query) p.set("q", query);
  if (pg && pg > 1) p.set("page", String(pg));
  const s = p.toString();
  return s ? `${studiesPath}?${s}` : studiesPath;
}

const origin = Astro.site?.origin ?? site.url;
const jsonLd = {
  "@type": "CollectionPage",
  name: `${title} — ${site.name}`,
  description,
  url: new URL(studiesPath, origin).href,
  isPartOf: { "@id": `${site.url}/#website` },
};
const chipBase =
  "inline-flex items-center rounded-full border px-3 py-1 font-mono text-xs uppercase tracking-widest transition-colors";
---

<PageLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHero
    eyebrow={t("studies.hero.eyebrow")}
    title={t("studies.hero.title")}
    lead={t("studies.hero.lead")}
  />

  <section class="container-flux pb-24">
    <div class="flex flex-col gap-5 border-b border-[var(--color-border)] pb-6">
      <form method="GET" action={studiesPath} class="flex w-full max-w-xl items-center gap-2">
        {activeTopic && <input type="hidden" name="topic" value={activeTopic} />}
        <input
          type="search"
          name="q"
          value={q}
          placeholder={t("studies.searchPlaceholder")}
          aria-label={t("studies.searchLabel")}
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-ink-line)] bg-surface px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-400 focus:border-ink-50 focus:outline-none"
        />
        <button
          type="submit"
          class="rounded-[var(--radius-md)] border border-border-strong bg-ink-50 px-4 py-2.5 text-sm font-medium text-ink-950 transition-opacity hover:opacity-90"
        >
          {t("studies.searchButton")}
        </button>
      </form>

      <div class="flex flex-wrap gap-2">
        <a
          href={buildUrl({ topic: null, page: null })}
          class:list={[chipBase, !activeTopic ? "border-ink-50 bg-ink-50 text-ink-950" : "border-[var(--color-ink-line)] text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
        >
          {t("studies.filterAll")}
        </a>
        {
          topics.map((tp) => (
            <a
              href={buildUrl({ topic: tp.slug, page: null })}
              class:list={[chipBase, activeTopic === tp.slug ? "border-ink-50 bg-ink-50 text-ink-950" : "border-[var(--color-ink-line)] text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
            >
              {tp.name}
              {typeof tp.articleCount === "number" && <span class="ml-1.5 opacity-60">{tp.articleCount}</span>}
            </a>
          ))
        }
        {hasFilters && (
          <a
            href={studiesPath}
            class:list={[chipBase, "gap-1.5 border-dashed border-ink-400 text-ink-400 hover:border-ink-50 hover:text-ink-50"]}
          >
            <Icon name="close" size={11} />
            {t("studies.clearFilters")}
          </a>
        )}
      </div>
    </div>

    <Divider
      class="mt-6"
      label={`${total} ${total === 1 ? t("studies.countOne") : t("studies.countMany")}${q ? ` · “${q}”` : ""}${activeTopic ? ` · ${activeTopicLabel}` : ""}`}
    />

    {
      cards.length > 0 ? (
        <div class="grid gap-4 py-10 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger="80">
          {cards.map((study) => (
            <ArticleCard
              href={study.href}
              title={study.title}
              description={study.description}
              kind="study"
              topics={study.topics}
              date={study.date}
              readingTime={study.readingTime}
              cover={study.cover}
            />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center">
          <p class="text-lg text-ink-300">{t("studies.empty")}</p>
          <a href={studiesPath} class="mt-3 inline-block font-mono text-xs uppercase tracking-widest text-ink-400 underline hover:text-ink-50">
            {t("studies.clearFilters")}
          </a>
        </div>
      )
    }

    {
      totalPages > 1 && (
        <nav class="flex items-center justify-center gap-2 pt-4" aria-label={t("studies.pagination")}>
          <a
            href={buildUrl({ page: page - 1 })}
            aria-disabled={page <= 1}
            class:list={["rounded-[var(--radius-md)] border border-[var(--color-ink-line)] px-3 py-2 font-mono text-xs uppercase tracking-widest", page <= 1 ? "pointer-events-none opacity-40" : "text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
          >
            {t("studies.prev")}
          </a>
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <a
              href={buildUrl({ page: n })}
              aria-current={n === page ? "page" : undefined}
              class:list={["rounded-[var(--radius-md)] border px-3.5 py-2 font-mono text-xs", n === page ? "border-ink-50 bg-ink-50 text-ink-950" : "border-[var(--color-ink-line)] text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
            >
              {n}
            </a>
          ))}
          <a
            href={buildUrl({ page: page + 1 })}
            aria-disabled={page >= totalPages}
            class:list={["rounded-[var(--radius-md)] border border-[var(--color-ink-line)] px-3 py-2 font-mono text-xs uppercase tracking-widest", page >= totalPages ? "pointer-events-none opacity-40" : "text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
          >
            {t("studies.next")}
          </a>
        </nav>
      )
    }
  </section>

  <CtaSection
    eyebrow={t("studies.ctaEyebrow")}
    title={t("studies.ctaTitle")}
    lead={t("studies.ctaLead")}
  />
</PageLayout>
