---
// Server-rendered article index, locale-aware. Reads the active locale from the
// URL, requests that language from site-api (falling back to the bundled content
// collection when the API is unreachable), and keeps every link inside the
// locale. Rendered by both /articles (fr, unprefixed) and /en/articles.
//
// site-api returns one row per logical article: the translation when it exists,
// the canonical english edition otherwise. Cards whose `lang` is not the active
// locale are badged rather than hidden.
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import CtaSection from "@organisms/CtaSection.astro";
import ArticleCard from "@molecules/ArticleCard.astro";
import Divider from "@atoms/Divider.astro";
import TopicFilter from "@molecules/TopicFilter.astro";
import { contentIndexUrl, parseTopicParams, readingTime, slugify } from "@lib/utils";
import { site } from "@lib/site";
import { createApiClient, type ArticleType, type Topic } from "@lib/api";
import { localeFromPath, localizedPath, useTranslations } from "@i18n";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const title = t("articles.title");
const description = t("articles.description");
const articlesPath = localizedPath("/articles", locale);

const PAGE_SIZE = 6;
const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim();
const activeTopics = parseTopicParams(params);
const page = Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1);

type Card = {
  href: string;
  title: string;
  description: string;
  topics: string[];
  date: string;
  readingTime: number;
  cover?: string | null;
  featured: boolean;
  lang?: string;
};

const runtimeEnv = (Astro.locals as { runtime?: { env?: Record<string, string> } })?.runtime?.env;
const apiBaseUrl = runtimeEnv?.API_BASE_URL ?? import.meta.env.API_BASE_URL;

let cards: Card[] = [];
let topics: Topic[] = [];
let total = 0;
let source: "api" | "content" = "content";

if (apiBaseUrl) {
  try {
    const api = createApiClient({ baseUrl: apiBaseUrl, lang: locale });
    const [list, topicList] = await Promise.all([
      api.listArticles({
        types: ["blog"] as ArticleType[],
        topics: activeTopics.length ? activeTopics : undefined,
        search: q || undefined,
        sort: "featured",
        page,
        pageSize: PAGE_SIZE,
      }),
      api.listTopics({ types: ["blog"] as ArticleType[] }),
    ]);
    total = list.total;
    cards = list.items.map((a) => ({
      href: localizedPath(`/articles/${a.slug}`, locale),
      title: a.title,
      description: a.shortdesc,
      topics: a.topics.map((tp) => tp.name),
      date: a.datePublished,
      readingTime: a.readingTime,
      cover: a.coverImage,
      featured: a.featured,
      lang: a.lang,
    }));
    topics = topicList;
    source = "api";
  } catch {
    source = "content";
  }
}

if (source === "content") {
  const entries = (await getCollection("articles", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );
  const filtered = entries.filter((e) => {
    const slugs = e.data.topics.map(slugify);
    return (
      (activeTopics.length === 0 || activeTopics.some((slug) => slugs.includes(slug))) &&
      (!q || `${e.data.title} ${e.data.description}`.toLowerCase().includes(q.toLowerCase()))
    );
  });
  total = filtered.length;
  cards = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map((e) => ({
    href: localizedPath(`/articles/${e.id}`, locale),
    title: e.data.title,
    description: e.data.description,
    topics: e.data.topics,
    date: e.data.publishDate.toISOString(),
    readingTime: readingTime(e.body ?? ""),
    cover: e.data.cover ?? null,
    featured: e.data.featured,
  }));

  const counts = new Map<string, Topic>();
  entries.forEach((e) =>
    e.data.topics.forEach((name) => {
      const slug = slugify(name);
      const entry = counts.get(slug);
      if (entry) entry.articleCount = (entry.articleCount ?? 0) + 1;
      else counts.set(slug, { name, slug, articleCount: 1 });
    }),
  );
  topics = [...counts.values()];
}

const activeTopicLabels = activeTopics.map(
  (slug) => topics.find((tp) => tp.slug === slug)?.name ?? slug,
);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

const pageUrl = (n: number) => contentIndexUrl(articlesPath, { topics: activeTopics, q, page: n });

const origin = Astro.site?.origin ?? site.url;
const jsonLd = {
  "@type": "Blog",
  name: `${title} — ${site.name}`,
  description,
  url: new URL(articlesPath, origin).href,
  publisher: { "@id": `${site.url}/#organization` },
};
---

<PageLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHero eyebrow={t("articles.eyebrow")} title={title} lead={description} />

  <section class="container-flux pb-24">
    <div class="flex flex-col gap-5 border-b border-[var(--color-border)] pb-6">
      <form
        method="GET"
        action={articlesPath}
        class="flex w-full max-w-xl items-center gap-2"
        data-analytics-form="articles_search"
      >
        {activeTopics.map((slug) => <input type="hidden" name="topic" value={slug} />)}
        <input
          type="search"
          name="q"
          value={q}
          placeholder={t("articles.searchPlaceholder")}
          aria-label={t("articles.searchLabel")}
          class="w-full rounded-[var(--radius-md)] border border-[var(--color-ink-line)] bg-surface px-4 py-2.5 text-sm text-ink-50 placeholder:text-ink-400 focus:border-ink-50 focus:outline-none"
        />
        <button
          type="submit"
          class="rounded-[var(--radius-md)] border border-border-strong bg-ink-50 px-4 py-2.5 text-sm font-medium text-ink-950 transition-opacity hover:opacity-90"
        >
          {t("articles.searchButton")}
        </button>
      </form>

      <TopicFilter
        topics={topics}
        active={activeTopics}
        basePath={articlesPath}
        q={q}
        section="articles_filters"
        labels={{
          group: t("filters.group"),
          all: t("articles.filterAll"),
          clear: t("articles.clearFilters"),
          more: t("filters.more"),
          less: t("filters.less"),
          add: t("filters.addTopic"),
          remove: t("filters.removeTopic"),
        }}
      />
    </div>

    <Divider
      class="mt-6"
      label={`${total} ${total === 1 ? t("articles.countOne") : t("articles.countMany")}${q ? ` · “${q}”` : ""}${activeTopicLabels.length ? ` · ${activeTopicLabels.join(" · ")}` : ""}`}
    />

    {
      cards.length > 0 ? (
        <div class="grid gap-4 py-10 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger="80">
          {cards.map((article, index) => (
            <ArticleCard
              href={article.href}
              title={article.title}
              description={article.description}
              kind="article"
              topics={article.topics}
              date={article.date}
              readingTime={article.readingTime}
              cover={article.cover}
              lang={article.lang}
              origin="articles_index"
              position={(page - 1) * PAGE_SIZE + index + 1}
            />
          ))}
        </div>
      ) : (
        <div class="py-20 text-center">
          <p class="text-lg text-ink-300">{t("articles.empty")}</p>
          <a href={articlesPath} class="mt-3 inline-block font-mono text-xs uppercase tracking-widest text-ink-400 underline hover:text-ink-50">
            {t("articles.clearFilters")}
          </a>
        </div>
      )
    }

    {
      totalPages > 1 && (
        <nav
          class="flex items-center justify-center gap-2 pt-4"
          aria-label={t("articles.pagination")}
          data-analytics-section="articles_pagination"
        >
          <a
            href={pageUrl(page - 1)}
            aria-disabled={page <= 1}
            data-analytics="pagination"
            data-analytics-direction="prev"
            data-analytics-page={String(page - 1)}
            class:list={["rounded-[var(--radius-md)] border border-[var(--color-ink-line)] px-3 py-2 font-mono text-xs uppercase tracking-widest", page <= 1 ? "pointer-events-none opacity-40" : "text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
          >
            {t("articles.prev")}
          </a>
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <a
              href={pageUrl(n)}
              aria-current={n === page ? "page" : undefined}
              data-analytics="pagination"
              data-analytics-direction="jump"
              data-analytics-page={String(n)}
              class:list={["rounded-[var(--radius-md)] border px-3.5 py-2 font-mono text-xs", n === page ? "border-ink-50 bg-ink-50 text-ink-950" : "border-[var(--color-ink-line)] text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
            >
              {n}
            </a>
          ))}
          <a
            href={pageUrl(page + 1)}
            aria-disabled={page >= totalPages}
            data-analytics="pagination"
            data-analytics-direction="next"
            data-analytics-page={String(page + 1)}
            class:list={["rounded-[var(--radius-md)] border border-[var(--color-ink-line)] px-3 py-2 font-mono text-xs uppercase tracking-widest", page >= totalPages ? "pointer-events-none opacity-40" : "text-ink-300 hover:border-ink-50 hover:text-ink-50"]}
          >
            {t("articles.next")}
          </a>
        </nav>
      )
    }
  </section>

  <CtaSection
    eyebrow={t("articles.ctaEyebrow")}
    title={t("articles.ctaTitle")}
    lead={t("articles.ctaLead")}
  />
</PageLayout>
