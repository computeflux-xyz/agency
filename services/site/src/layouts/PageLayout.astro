---
import BaseLayout from "./BaseLayout.astro";
import Header from "@organisms/Header.astro";
import Footer from "@organisms/Footer.astro";
import DragonStage from "@organisms/DragonStage.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: string;
  dragon?: boolean;
}
const { dragon = false, ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <div class="page-underlay pointer-events-none" aria-hidden="true">
    <slot name="underlay" />
  </div>
  <Header />
  <main id="main" class="min-h-screen">
    <slot />
  </main>
  <Footer />
  {dragon && <DragonStage />}
</BaseLayout>

<style>
  .page-underlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 0;
  }
</style>
