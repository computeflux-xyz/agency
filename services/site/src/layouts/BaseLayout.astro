---
import "@styles/global.css";
import { site, siteFor, twitterHandle } from "@lib/site";
import {
  jsonLdGraph,
  organizationSchema,
  websiteSchema,
  webPageSchema,
} from "@lib/seo";
import {
  getLocale,
  toCanonicalPath,
  alternates as buildAlternates,
  useTranslations,
  type Alternate,
} from "@i18n";
import { pageContextFor } from "@lib/analytics";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: string;
  minimalSchema?: boolean;
  /** Override the hreflang alternate set (e.g. article pages). */
  alternates?: Alternate[];
  /** Suppress hreflang alternates entirely (e.g. 404). */
  noAlternates?: boolean;
  /**
   * Analytics page type. Derived from the URL when omitted (see
   * `@lib/analytics`). Pass it only when the URL under-describes the page.
   */
  pageType?: string;
  /** Analytics: "article" | "study" | ... for content pages. */
  contentKind?: string;
  /** Analytics: topics of the content being read. */
  contentTopics?: string[];
  /** Analytics: declared reading time, in minutes. */
  contentReadingTime?: number;
}

const locale = getLocale(Astro);
const localizedSite = siteFor(locale);
const t = useTranslations(locale);

const {
  title,
  description = localizedSite.description,
  image = site.defaultOgImage,
  ogType = "website",
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
  canonical: canonicalOverride,
  minimalSchema = false,
  alternates: alternatesOverride,
  noAlternates = false,
  pageType: pageTypeOverride,
  contentKind,
  contentTopics = [],
  contentReadingTime,
} = Astro.props;

const runtimeEnv = (Astro.locals as { runtime?: { env?: Record<string, string> } })?.runtime?.env;

const fullTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${localizedSite.tagline}`;

const origin = Astro.site?.origin ?? site.url;
const canonical = (canonicalOverride ?? new URL(Astro.url.pathname, origin).href).replace(/\/$/, "") || origin;
const ogImage = new URL(image, origin).href;

// hreflang alternates for the current page's canonical (locale-stripped) path.
const canonicalPath = toCanonicalPath(Astro.url.pathname);
const alternateLinks = noAlternates
  ? []
  : (alternatesOverride ?? buildAlternates(canonicalPath, origin));

// Cookieless analytics (Umami). Loaded only when both the
// script src and website id are configured, so it's a no-op until you set them
// (PUBLIC_ prefixed -> safe to expose). Runtime env (Cloudflare vars) wins in
// SSR. import.meta.env covers prerendered pages at build time. The article
// embed forwards in-iframe interactions to window.umami.track (see
// ObservableEmbed.astro), so engagement inside the sandboxed article is
// measurable too.
//
// PUBLIC_UMAMI_HOST_URL is needed whenever the collect endpoint does not live
// next to script.js. Which is our case: the gateway exposes only
// /push-analytics/script.js and /push-analytics/api/send, never the Umami
// login portal. PUBLIC_UMAMI_TAG (optional) labels every event with the
// environment so preview traffic can be filtered out of the dashboard.
const umamiSrc = runtimeEnv?.PUBLIC_UMAMI_SRC ?? import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = runtimeEnv?.PUBLIC_UMAMI_WEBSITE_ID ?? import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiHostUrl = runtimeEnv?.PUBLIC_UMAMI_HOST_URL ?? import.meta.env.PUBLIC_UMAMI_HOST_URL;
const umamiTag = runtimeEnv?.PUBLIC_UMAMI_TAG ?? import.meta.env.PUBLIC_UMAMI_TAG;

// Page context published on <body>. Every custom event carries these fields
// (see @lib/client/analytics), so any interaction can be broken down by page
// type, slug, locale or topic without joining anything in the dashboard.
const derived = pageContextFor(canonicalPath);
const pageType = pageTypeOverride ?? derived.pageType;

const graphNodes: (Record<string, unknown> | Record<string, unknown>[])[] = [
  organizationSchema(),
  websiteSchema(localizedSite.lang),
];
if (!minimalSchema) {
  graphNodes.push(
    webPageSchema({ url: canonical, title: fullTitle, description, lang: localizedSite.lang }),
  );
}
if (jsonLd) graphNodes.push(jsonLd);
const structuredData = jsonLdGraph(...graphNodes);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }

    <meta name="theme-color" content={site.themeColor} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localizedSite.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Articles`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={structuredData} is:inline />

    {
      umamiSrc && umamiWebsiteId && (
        <script
          defer
          src={umamiSrc}
          data-website-id={umamiWebsiteId}
          data-host-url={umamiHostUrl || undefined}
          data-tag={umamiTag || undefined}
          is:inline
        />
      )
    }
  </head>
  <body
    data-page-type={pageType}
    data-page-slug={derived.slug || undefined}
    data-locale={locale}
    data-content-kind={contentKind || undefined}
    data-content-topics={contentTopics.length ? contentTopics.join(",") : undefined}
    data-content-reading-time={contentReadingTime ? String(contentReadingTime) : undefined}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink-50 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-ink-950"
    >
      {t("a11y.skipToContent")}
    </a>

    <slot />

    <script>
      import { initReveal } from "@lib/client/reveal";
      import { initScramble } from "@lib/client/scramble";
      import { initTabs } from "@lib/client/tabs";
      import { initAnalytics } from "@lib/client/analytics";

      function boot() {
        initReveal();
        initScramble();
        initTabs();
        initAnalytics();
      }
      boot();
      document.addEventListener("astro:after-swap", boot);
    </script>
  </body>
</html>
