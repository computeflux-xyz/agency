---
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import JobCard from "@molecules/JobCard.astro";
import Divider from "@atoms/Divider.astro";
import Icon from "@atoms/Icon.astro";
import { getJobs } from "@data/jobs";
import { site } from "@lib/site";
import { getLocale, localizedPath, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const jobs = getJobs(locale);

const perks = [
  { icon: "spark", text: t("careers.perk1") },
  { icon: "layers", text: t("careers.perk2") },
  { icon: "check", text: t("careers.perk3") },
  { icon: "bolt", text: t("careers.perk4") },
];

const origin = Astro.site?.origin ?? site.url;
const jsonLd = jobs.map((job) => ({
  "@type": "JobPosting",
  title: job.title,
  description: job.summary,
  datePosted: job.datePosted,
  employmentType: "CONTRACTOR",
  hiringOrganization: { "@id": `${site.url}/#organization` },
  jobLocationType: "TELECOMMUTE",
  url: `${origin}/careers/${job.slug}`,
  applicantLocationRequirements: { "@type": "Country", name: "European Union" },
}));

const rolesLabel = jobs.length === 1 ? t("careers.openRolesOne") : t("careers.openRolesMany");
---

<PageLayout title={t("careers.title")} description={t("careers.metaDescription")} jsonLd={jsonLd}>
  <PageHero
    eyebrow={t("careers.hero.eyebrow")}
    title={t("careers.hero.title")}
    lead={t("careers.hero.lead")}
  />

  <section class="container-flux pb-8">
    <Divider label={t("careers.why")} />
    <div class="grid gap-4 py-12 sm:grid-cols-2" data-reveal-stagger="80">
      {
        perks.map((p) => (
          <div class="flex items-start gap-4 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-ink-900/40 p-6" data-reveal>
            <span class="mt-0.5 shrink-0 text-flux-blue"><Icon name={p.icon} size={20} /></span>
            <p class="text-pretty leading-relaxed text-ink-200">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-flux py-12 md:py-16">
    <Divider label={jobs.length === 0 ? t("careers.closedLabel") : `${jobs.length} ${rolesLabel}`} />
    {
      jobs.length === 0 ? (
        <div class="py-12" data-reveal>
          <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] bg-ink-900/40 p-8 text-center md:p-12">
            <p class="text-lg font-medium text-ink-100">{t("careers.closedTitle")}</p>
            <p class="mx-auto mt-4 max-w-xl text-pretty leading-relaxed text-ink-300">{t("careers.closedLead")}</p>
            <a href={localizedPath("/contact", locale)} class="mt-6 inline-block text-sm text-flux-blue hover:underline">
              {t("careers.closedCta")} →
            </a>
          </div>
        </div>
      ) : (
        <>
          <div class="flex flex-col gap-4 py-12" data-reveal-stagger="80">
            {jobs.map((job) => (
              <JobCard job={job} href={localizedPath(`/careers/${job.slug}`, locale)} cta={t("careers.viewRole")} />
            ))}
          </div>
          <p class="text-center text-sm text-ink-400" data-reveal>
            {t("careers.noRoleLead")}
            <a href={`mailto:${site.email}?subject=Open application`} class="text-flux-blue hover:underline">
              {t("careers.noRoleTitle")} →
            </a>
          </p>
        </>
      )
    }
  </section>
</PageLayout>
