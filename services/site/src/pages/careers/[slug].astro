---
import type { GetStaticPaths } from "astro";
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import Divider from "@atoms/Divider.astro";
import Tag from "@atoms/Tag.astro";
import Icon from "@atoms/Icon.astro";
import Button from "@atoms/Button.astro";
import Field from "@atoms/Field.astro";
import ApiNotice from "@molecules/ApiNotice.astro";
import { jobSlugs, getJob } from "@data/jobs";
import { jobPostingSchema, breadcrumbSchema } from "@lib/seo";
import { site } from "@lib/site";
import { getLocale, localizedPath, useTranslations } from "@i18n";

export const getStaticPaths = (() => {
  return jobSlugs.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const locale = getLocale(Astro);
const t = useTranslations(locale);

const job = getJob(locale, slug!);
if (!job) return Astro.redirect(localizedPath("/careers", locale));

const origin = Astro.site?.origin ?? site.url;

const jsonLd = [
  jobPostingSchema({
    title: job.title,
    description: job.summary,
    datePosted: job.datePosted,
    employmentType: "CONTRACTOR",
    remote: job.remote,
    location: job.location,
  }),
  breadcrumbSchema([
    { name: "Home", url: origin },
    { name: t("careers.title"), url: `${origin}/careers` },
    { name: job.title, url: `${origin}/careers/${job.slug}` },
  ]),
];
---

<PageLayout title={job.title} description={job.summary} jsonLd={jsonLd}>
  <PageHero eyebrow={t("careers.openRole")} title={job.title} lead={job.summary}>
    <div class="mt-2 flex flex-wrap gap-1.5" data-reveal>
      <Tag size="xs">{job.team}</Tag>
      <Tag size="xs">{job.location}</Tag>
      <Tag size="xs">{job.type}</Tag>
    </div>
  </PageHero>

  <section class="container-flux pb-24">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="flex flex-col gap-10">
        <div>
          <h2 class="mb-5 text-xl font-semibold text-ink-50">{t("careers.doTitle")}</h2>
          <ul class="flex flex-col gap-3">
            {
              job.responsibilities.map((r) => (
                <li class="flex items-start gap-3 text-ink-200">
                  <span class="mt-1 shrink-0 text-flux-blue"><Icon name="check" size={16} /></span>
                  <span class="text-pretty leading-relaxed">{r}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="mb-5 text-xl font-semibold text-ink-50">{t("careers.lookingTitle")}</h2>
          <ul class="flex flex-col gap-3">
            {
              job.requirements.map((r) => (
                <li class="flex items-start gap-3 text-ink-200">
                  <span class="mt-1 shrink-0 text-flux-magenta"><Icon name="check" size={16} /></span>
                  <span class="text-pretty leading-relaxed">{r}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:sticky lg:top-24 lg:h-fit">
        <div class="flex flex-col gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-ink-900/50 p-7">
          <div class="flex flex-col gap-1">
            <h2 class="text-lg font-semibold text-ink-50">{t("careers.applyTitle")}</h2>
            <p class="text-sm text-ink-400">{t("careers.applyLead")}</p>
          </div>

          <ApiNotice />

          <form class="flex flex-col gap-4" data-apply-form aria-label={`${t("careers.applyTitle")} — ${job.title}`}>
            <input type="hidden" name="role" value={job.title} />
            <Field label={t("careers.applyName")} name="name" required disabled />
            <Field label={t("careers.applyEmail")} name="email" type="email" required disabled />
            <Field
              label={t("careers.applyLinks")}
              name="links"
              placeholder="github.com/you"
              disabled
            />
            <Field
              label={t("careers.applyWhy")}
              name="message"
              as="textarea"
              rows={4}
              required
              disabled
              hint={t("careers.applyWhyHint")}
            />
            <Button type="submit" variant="primary" fullWidth disabled arrow>
              {t("careers.submit")}
            </Button>
          </form>
        </div>
      </div>
    </div>

    <Divider class="mt-16" />
    <div class="pt-8">
      <Button href={localizedPath("/careers", locale)} variant="ghost">{t("careers.allRoles")}</Button>
    </div>
  </section>
</PageLayout>
