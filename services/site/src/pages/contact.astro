---
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import Field from "@atoms/Field.astro";
import Button from "@atoms/Button.astro";
import Icon from "@atoms/Icon.astro";
import Divider from "@atoms/Divider.astro";
import { site } from "@lib/site";
import { getLocale, localizedPath, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);

const channels = [
  { icon: "mail", label: t("contact.channelEmail"), value: site.email, href: `mailto:${site.email}` },
  { icon: "calendar", label: t("contact.channelBook"), value: t("contact.channelBookValue"), href: localizedPath("/book", locale) },
  { icon: "spark", label: t("contact.channelCareers"), value: t("contact.channelCareersValue"), href: localizedPath("/careers", locale) },
];
---

<PageLayout title={t("contact.title")} description={t("contact.metaDescription")}>
  <PageHero
    eyebrow={t("contact.hero.eyebrow")}
    title={t("contact.hero.title")}
    lead={t("contact.hero.lead")}
  />

  <section class="container-flux pb-24">
    <Divider label={t("nav.contact")} />
    <div class="grid gap-12 py-12 lg:grid-cols-[1fr_1.2fr]">
      <!-- Channels -->
      <div class="flex flex-col gap-4">
        {
          channels.map((c) => (
            <a
              href={c.href}
              class="group flex items-center gap-4 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-ink-900/40 p-5 transition-colors hover:border-[var(--color-border-strong)] hover:bg-ink-850"
            >
              <span class="flex size-11 items-center justify-center rounded-full border border-[var(--color-border)] text-flux-blue">
                <Icon name={c.icon} size={18} />
              </span>
              <span class="flex flex-col">
                <span class="font-mono text-[0.65rem] uppercase tracking-widest text-ink-400">{c.label}</span>
                <span class="font-medium text-ink-50">{c.value}</span>
              </span>
              <Icon name="arrow" size={16} class="ml-auto text-ink-400 transition-transform group-hover:translate-x-0.5" />
            </a>
          ))
        }
        <p class="mt-2 text-sm leading-relaxed text-ink-400">
          {t("contact.basedNote").replace("{location}", site.location)}
        </p>
      </div>

      <!-- Form -->
      <div class="flex flex-col gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-ink-900/50 p-7">
        <h2 class="text-lg font-semibold text-ink-50">{t("contact.formTitle")}</h2>
        <form
          class="flex flex-col gap-4"
          data-contact-form
          aria-label={t("contact.formTitle")}
          data-msg-sending={t("contact.sending")}
          data-msg-success={t("contact.sent")}
          data-msg-error={t("contact.error")}
          data-msg-network={t("contact.networkError")}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("contact.firstName")} name="name" required />
            <Field label={t("contact.lastName")} name="surname" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("contact.email")} name="email" type="email" required />
            <Field label={t("contact.phoneNumber")} name="phoneNumber" type="tel" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("contact.company")} name="company" hint={t("contact.optional")} />
            <Field
              label={t("contact.linkedin")}
              name="linkedinProfile"
              type="url"
              placeholder="https://www.linkedin.com/in/…"
              hint={t("contact.optional")}
            />
          </div>

          <fieldset class="flex flex-col gap-2">
            <legend class="flex items-center gap-1.5 font-mono text-[0.72rem] font-medium uppercase tracking-wider text-ink-300">
              {t("contact.reach")}
              <span class="text-flux-magenta" aria-hidden="true">*</span>
            </legend>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex cursor-pointer items-center gap-2.5 rounded-[var(--radius-md)] border border-[var(--color-ink-line)] bg-ink-950 px-4 py-3 text-ink-50 transition-colors has-[:checked]:border-flux-blue has-[:checked]:bg-ink-900">
                <input type="radio" name="preferredContact" value="phone" required style="accent-color: var(--color-flux-blue)" />
                <span class="text-sm">{t("contact.byPhone")}</span>
              </label>
              <label class="flex cursor-pointer items-center gap-2.5 rounded-[var(--radius-md)] border border-[var(--color-ink-line)] bg-ink-950 px-4 py-3 text-ink-50 transition-colors has-[:checked]:border-flux-blue has-[:checked]:bg-ink-900">
                <input type="radio" name="preferredContact" value="email" required style="accent-color: var(--color-flux-blue)" />
                <span class="text-sm">{t("contact.byEmail")}</span>
              </label>
            </div>
          </fieldset>

          <Field label={t("contact.message")} name="message" as="textarea" rows={5} required />

          <Button type="submit" variant="primary" fullWidth arrow>{t("contact.send")}</Button>

          <p
            data-contact-status
            role="status"
            aria-live="polite"
            hidden
            class="text-sm text-ink-400"
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import { enhancePhoneInput, getPhoneE164 } from "@lib/client/phone";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const statusEl = form.querySelector<HTMLElement>("[data-contact-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const phoneInput = form.querySelector<HTMLInputElement>('input[name="phoneNumber"]');
    if (phoneInput) enhancePhoneInput(phoneInput);

    const msg = {
      sending: form.dataset.msgSending ?? "",
      success: form.dataset.msgSuccess ?? "",
      error: form.dataset.msgError ?? "",
      network: form.dataset.msgNetwork ?? "",
    };

    const setStatus = (message: string, tone: "idle" | "error" | "success") => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.hidden = message === "";
      statusEl.className =
        "text-sm " +
        (tone === "error"
          ? "text-flux-magenta"
          : tone === "success"
            ? "text-flux-blue"
            : "text-ink-400");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitBtn) submitBtn.disabled = true;
      setStatus(msg.sending, "idle");

      const data = new FormData(form);
      const payload = {
        name: String(data.get("name") ?? ""),
        surname: String(data.get("surname") ?? ""),
        email: String(data.get("email") ?? ""),
        phoneNumber: phoneInput ? getPhoneE164(phoneInput) : String(data.get("phoneNumber") ?? ""),
        preferredContact: String(data.get("preferredContact") ?? ""),
        company: String(data.get("company") ?? ""),
        linkedinProfile: String(data.get("linkedinProfile") ?? ""),
        message: String(data.get("message") ?? ""),
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };

        if (res.ok && body.ok) {
          form.reset();
          setStatus(msg.success, "success");
        } else {
          setStatus(body.message ?? msg.error, "error");
        }
      } catch {
        setStatus(msg.network, "error");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
