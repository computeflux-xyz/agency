---
import type { GetStaticPaths } from "astro";
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import CtaSection from "@organisms/CtaSection.astro";
import Divider from "@atoms/Divider.astro";
import Icon from "@atoms/Icon.astro";
import Button from "@atoms/Button.astro";
import { expertiseSlugs, getExpertise, getExpertiseItem } from "@data/expertise";
import { getSources } from "@data/sovereignty";
import { getMediaItem, getMediaPending } from "@data/media";
import PracticeDetail from "@organisms/PracticeDetail.astro";
import ExpertiseHero from "@organisms/ExpertiseHero.astro";
import MoebiusNav from "@molecules/MoebiusNav.astro";
import SectionHeader from "@molecules/SectionHeader.astro";
import { getDataEngineering } from "@data/dataEngineering";
import { getAiEngineering } from "@data/aiEngineering";
import { getBareMetal } from "@data/bareMetal";
import { getAgenticSystems } from "@data/agenticSystems";
import { getInferenceOptimization } from "@data/inferenceOptimization";
import type { PracticeContent, PracticeFlow } from "@data/practiceContent";
import { breadcrumbSchema } from "@lib/seo";
import { site } from "@lib/site";
import { getLocale, localizedPath, useTranslations } from "@i18n";

export const getStaticPaths = (() => {
  return expertiseSlugs.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const locale = getLocale(Astro);
const t = useTranslations(locale);

const item = getExpertiseItem(locale, slug!);
if (!item) return Astro.redirect(localizedPath("/expertise", locale));

const origin = Astro.site?.origin ?? site.url;
const others = getExpertise(locale).filter((e) => e.slug !== item.slug);
const isBareMetal = item.slug === "bare-metal";

const FULL: Record<string, { key: string; load: () => { content: PracticeContent; flow: PracticeFlow } }> = {
  "data-engineering": { key: "de", load: () => getDataEngineering(locale) },
  "ai-engineering": { key: "ai", load: () => getAiEngineering(locale) },
  "bare-metal": { key: "bm", load: () => getBareMetal(locale) },
  "agentic-systems": { key: "ag", load: () => getAgenticSystems(locale) },
  "inference-optimization": { key: "io", load: () => getInferenceOptimization(locale) },
};

const full = FULL[item.slug];
const practice = full?.load() ?? null;
const heroMedia = full ? getMediaItem(locale, `${full.key}-hero`) : undefined;
const heroTitle = practice?.content.heroTitle ?? item.title;
const heroLead = practice?.content.heroLead ?? item.tagline;
const sources = isBareMetal ? getSources(locale) : [];
const claims = isBareMetal
  ? (["c1", "c2", "c3"] as const).map((key, i) => ({
      n: String(i + 1).padStart(2, "0"),
      title: t(`sov.${key}.title`),
      body: t(`sov.${key}.body`),
    }))
  : [];

const jsonLd = [
  {
    "@type": "Service",
    name: item.title,
    description: item.summary,
    provider: { "@id": `${site.url}/#organization` },
    serviceType: item.title,
    areaServed: "Worldwide",
  },
  breadcrumbSchema([
    { name: "Home", url: origin },
    { name: t("expertise.title"), url: `${origin}/expertise` },
    { name: item.title, url: `${origin}/expertise/${item.slug}` },
  ]),
];
---

<PageLayout title={item.title} description={item.summary} jsonLd={jsonLd}>
  {
    heroMedia ? (
      <ExpertiseHero
        eyebrow={`${t("expertise.detail.practice")}`}
        title={heroTitle}
        lead={heroLead}
        ctaLabel={t("nav.bookCall")}
        ctaHref={localizedPath("/book", locale)}
        media={heroMedia}
        pendingLabel={getMediaPending(locale)}
      />
    ) : (
      <PageHero
        eyebrow={`${t("expertise.detail.practice")}`}
        title={item.title}
        lead={item.tagline}
      />
    )
  }

  {full && practice ? (
    <PracticeDetail
      item={item}
      content={practice.content}
      flow={practice.flow}
      overviewMedia={[`${full.key}-overview-a`, `${full.key}-overview-b`]}
    />
  ) : (
    <>
      <section class="container-flux pb-8">
        <Divider label={t("expertise.overview")} />
        <div class="py-12">
          <p class="max-w-3xl text-pretty text-xl leading-relaxed text-ink-200" data-reveal>{item.intro}</p>
        </div>
      </section>

      <section class="container-flux py-12 md:py-16">
        <Divider label={t("expertise.capabilities")} />
        <div class="grid gap-4 py-12 md:grid-cols-2" data-reveal-stagger="80">
          {
            item.capabilities.map((cap) => (
              <article
                class="flex flex-col gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-ink-900/40 p-6"
                data-reveal
              >
                <span class="flex size-9 items-center justify-center rounded-full border border-[var(--color-border)] text-flux-blue">
                  <Icon name="check" size={16} />
                </span>
                <h3 class="text-lg font-semibold tracking-tight text-ink-50">{cap.title}</h3>
                <p class="text-pretty text-[0.95rem] leading-relaxed text-ink-300">{cap.description}</p>
              </article>
            ))
          }
        </div>
      </section>
    </>
  )}

  {isBareMetal && (
    <section class="container-flux py-12 md:py-16">
      <Divider label={t("sov.sectionLabel")} />
      <p class="max-w-3xl text-pretty py-10 text-lg leading-relaxed text-ink-200" data-reveal>
        {t("sov.lead")}
      </p>
      <div class="grid gap-x-10 gap-y-10 pb-12 md:grid-cols-3" data-reveal-stagger="80">
        {
          claims.map((claim) => (
            <div class="flex flex-col gap-3 border-t border-[var(--color-ink-line)] pt-6" data-reveal>
              <div class="flex items-baseline gap-3.5">
                <span class="font-mono text-xs text-ink-400" aria-hidden="true">{claim.n}</span>
                <h3 class="text-balance text-base font-semibold tracking-tight text-ink-50">{claim.title}</h3>
              </div>
              <p class="text-pretty text-[0.95rem] leading-relaxed text-ink-300">{claim.body}</p>
            </div>
          ))
        }
      </div>

      <Divider label={t("sov.sourcesLabel")} />
      <ul class="flex flex-col gap-2 py-8">
        {
          sources.map((source) => (
            <li class="font-mono text-[0.72rem] leading-relaxed text-ink-400">
              <span class="text-flux-blue" aria-hidden="true">[{source.n}]</span>{" "}
              <span class="text-ink-300">{source.publisher}</span>
              {", "}
              <a
                href={source.url}
                target="_blank"
                rel="noopener"
                class="underline decoration-ink-300/40 underline-offset-2 transition-colors hover:text-flux-blue"
              >
                {source.title}
              </a>
              {source.year && <span>{` (${source.year})`}</span>}
            </li>
          ))
        }
      </ul>
    </section>
  )}

  <section class="container-flux py-12 md:py-16">
    <SectionHeader
      eyebrow={t("expertise.related")}
      accent="blue"
      title={t("expertise.related.title")}
      lead={t("expertise.related.lead")}
    />
    <div class="pb-6 pt-2" data-reveal>
      <MoebiusNav
        items={others.map((o) => ({
          index: o.index,
          label: o.shortTitle,
          href: localizedPath(`/expertise/${o.slug}`, locale),
        }))}
        caption={t("expertise.related.title")}
      />
    </div>
    <div class="flex justify-center">
      <Button href={localizedPath("/expertise", locale)} variant="primary" size="lg" arrow>
        {t("expertise.all")}
      </Button>
    </div>
  </section>

  <CtaSection
    title={t("expertise.detail.ctaTitle").replace("{topic}", item.shortTitle.toLowerCase())}
    lead={item.summary}
  />
</PageLayout>
