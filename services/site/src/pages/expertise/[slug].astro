---
import type { GetStaticPaths } from "astro";
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import CtaSection from "@organisms/CtaSection.astro";
import Divider from "@atoms/Divider.astro";
import Icon from "@atoms/Icon.astro";
import Tag from "@atoms/Tag.astro";
import Button from "@atoms/Button.astro";
import { expertiseSlugs, getExpertise, getExpertiseItem } from "@data/expertise";
import { getSources, TOOLS } from "@data/sovereignty";
import { breadcrumbSchema } from "@lib/seo";
import { site } from "@lib/site";
import { getLocale, localizedPath, useTranslations } from "@i18n";

export const getStaticPaths = (() => {
  return expertiseSlugs.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const locale = getLocale(Astro);
const t = useTranslations(locale);

const item = getExpertiseItem(locale, slug!);
if (!item) return Astro.redirect(localizedPath("/expertise", locale));

const origin = Astro.site?.origin ?? site.url;
const others = getExpertise(locale).filter((e) => e.slug !== item.slug);

const isSovereignty = item.slug === "sovereignty";
const sources = isSovereignty ? getSources(locale) : [];
const claims = isSovereignty
  ? (["c1", "c2", "c3", "c4"] as const).map((key, i) => ({
      n: String(i + 1).padStart(2, "0"),
      title: t(`sov.${key}.title`),
      body: t(`sov.${key}.body`),
    }))
  : [];

const jsonLd = [
  {
    "@type": "Service",
    name: item.title,
    description: item.summary,
    provider: { "@id": `${site.url}/#organization` },
    serviceType: item.title,
    areaServed: "Worldwide",
  },
  breadcrumbSchema([
    { name: "Home", url: origin },
    { name: t("expertise.title"), url: `${origin}/expertise` },
    { name: item.title, url: `${origin}/expertise/${item.slug}` },
  ]),
];
---

<PageLayout title={item.title} description={item.summary} jsonLd={jsonLd}>
  <PageHero eyebrow={`${t("expertise.detail.practice")} ${item.index}`} title={item.title} lead={item.tagline} />

  <section class="container-flux pb-8">
    <Divider label={t("expertise.overview")} />
    <div class="py-12">
      <p class="max-w-3xl text-pretty text-xl leading-relaxed text-ink-200" data-reveal>{item.intro}</p>
    </div>
  </section>

  <section class="container-flux py-12 md:py-16">
    <Divider label={t("expertise.capabilities")} />
    <div class="grid gap-4 py-12 md:grid-cols-2" data-reveal-stagger="80">
      {
        item.capabilities.map((cap) => (
          <article
            class="flex flex-col gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-ink-900/40 p-6"
            data-reveal
          >
            <span class="flex size-9 items-center justify-center rounded-full border border-[var(--color-border)] text-flux-blue">
              <Icon name="check" size={16} />
            </span>
            <h3 class="text-lg font-semibold tracking-tight text-ink-50">{cap.title}</h3>
            <p class="text-pretty text-[0.95rem] leading-relaxed text-ink-300">{cap.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  {isSovereignty && (
    <section class="container-flux py-12 md:py-16">
      <Divider label={t("sovPage.steps")} />
      <div class="grid gap-x-10 gap-y-10 py-12 md:grid-cols-2" data-reveal-stagger="80">
        {
          claims.map((claim) => (
            <div class="flex flex-col gap-3 border-t border-[var(--color-ink-line)] pt-6" data-reveal>
              <div class="flex items-baseline gap-3.5">
                <span class="font-mono text-xs text-ink-400" aria-hidden="true">{claim.n}</span>
                <h3 class="text-balance text-lg font-semibold tracking-tight text-ink-50">{claim.title}</h3>
              </div>
              <p class="text-pretty leading-relaxed text-ink-300">{claim.body}</p>
            </div>
          ))
        }
      </div>

      <Divider label={t("sov.stackLabel")} />
      <div class="flex flex-wrap gap-2 py-8">
        {TOOLS.map((tool) => (
          <Tag size="xs">{tool}</Tag>
        ))}
      </div>

      <Divider label={t("sov.sourcesLabel")} />
      <ul class="flex flex-col gap-2 py-8">
        {
          sources.map((source) => (
            <li class="font-mono text-[0.72rem] leading-relaxed text-ink-400">
              <span class="text-flux-blue" aria-hidden="true">[{source.n}]</span>{" "}
              <span class="text-ink-300">{source.publisher}</span>
              {" — "}
              <a
                href={source.url}
                target="_blank"
                rel="noopener"
                class="underline decoration-ink-300/40 underline-offset-2 transition-colors hover:text-flux-blue"
              >
                {source.title}
              </a>
              {source.year && <span>{` (${source.year})`}</span>}
            </li>
          ))
        }
      </ul>
    </section>
  )}

  <section class="container-flux py-12 md:py-16">
    <Divider label={t("expertise.related")} />
    <div class="grid gap-4 py-12 sm:grid-cols-3" data-reveal-stagger="80">
      {
        others.map((o) => (
          <a
            href={localizedPath(`/expertise/${o.slug}`, locale)}
            class="group flex items-center justify-between gap-4 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-ink-900/40 p-5 transition-colors hover:border-[var(--color-border-strong)] hover:bg-ink-850"
            data-reveal
          >
            <span class="flex flex-col">
              <span class="font-mono text-xs text-ink-400">{o.index}</span>
              <span class="font-medium text-ink-50">{o.shortTitle}</span>
            </span>
            <Icon name="arrow" size={16} class="text-ink-400 transition-transform group-hover:translate-x-0.5" />
          </a>
        ))
      }
    </div>
    <div class="flex justify-center">
      <Button href={localizedPath("/expertise", locale)} variant="ghost" arrow>{t("expertise.all")}</Button>
    </div>
  </section>

  <CtaSection
    title={t("expertise.detail.ctaTitle").replace("{topic}", item.shortTitle.toLowerCase())}
    lead={item.summary}
  />
</PageLayout>
