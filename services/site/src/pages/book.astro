---
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import Field from "@atoms/Field.astro";
import Button from "@atoms/Button.astro";
import Icon from "@atoms/Icon.astro";
import Divider from "@atoms/Divider.astro";
import { site } from "@lib/site";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);

const expect = [t("book.expect1"), t("book.expect2"), t("book.expect3")];
---

<PageLayout title={t("book.title")} description={t("book.metaDescription")}>
  <PageHero
    eyebrow={t("book.hero.eyebrow")}
    title={t("book.hero.title")}
    lead={t("book.hero.lead")}
  />

  <section class="container-flux pb-24">
    <Divider label={t("book.expectTitle")} />
    <div class="grid gap-12 py-12 lg:grid-cols-[1fr_1.2fr]">
      <!-- What to expect -->
      <div class="flex flex-col gap-6">
        <h2 class="text-xl font-semibold text-ink-50">{t("book.expectTitle")}</h2>
        <ul class="flex flex-col gap-3">
          {
            expect.map((e) => (
              <li class="flex items-start gap-3 text-ink-200">
                <span class="mt-1 shrink-0 text-flux-blue"><Icon name="check" size={16} /></span>
                <span class="text-pretty leading-relaxed">{e}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-ink-900/40 p-5">
          <p class="text-sm text-ink-300">
            {t("book.preferEmail")}
            <a href={`mailto:${site.email}`} class="text-flux-blue hover:underline">{site.email}</a>.
          </p>
        </div>
      </div>

      <!-- Booking -->
      <div class="flex flex-col gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-ink-900/50 p-7">
        <div class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-full border border-[var(--color-border)] text-flux-blue">
            <Icon name="calendar" size={18} />
          </span>
          <div class="flex flex-col">
            <h2 class="text-lg font-semibold text-ink-50">{t("book.formTitle")}</h2>
            <p class="text-sm text-ink-400">{t("book.slotSubtitle")}</p>
          </div>
        </div>

        <form
          class="flex flex-col gap-4"
          data-book-form
          aria-label={t("book.formTitle")}
          data-msg-sending={t("book.sending")}
          data-msg-success={t("book.sent")}
          data-msg-error={t("book.error")}
          data-msg-network={t("book.networkError")}
          data-msg-window={t("book.windowError")}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("book.firstName")} name="name" required />
            <Field label={t("book.lastName")} name="surname" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("book.email")} name="email" type="email" required />
            <Field label={t("book.phoneNumber")} name="phoneNumber" type="tel" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("book.company")} name="company" hint={t("book.optional")} />
            <Field
              label={t("book.linkedin")}
              name="linkedinProfile"
              type="url"
              placeholder="https://www.linkedin.com/in/…"
              hint={t("book.optional")}
            />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label={t("book.windowFromLabel")} name="startDate" type="datetime-local" required />
            <Field label={t("book.windowToLabel")} name="endDate" type="datetime-local" required />
          </div>
          <Field
            label={t("book.aboutLabel")}
            name="message"
            as="textarea"
            rows={4}
            required
          />
          <Button type="submit" variant="primary" fullWidth arrow>{t("book.request")}</Button>

          <p
            data-book-status
            role="status"
            aria-live="polite"
            hidden
            class="text-sm text-ink-400"
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import { enhancePhoneInput, getPhoneE164 } from "@lib/client/phone";

  const form = document.querySelector<HTMLFormElement>("[data-book-form]");

  if (form) {
    const statusEl = form.querySelector<HTMLElement>("[data-book-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const phoneInput = form.querySelector<HTMLInputElement>('input[name="phoneNumber"]');
    if (phoneInput) enhancePhoneInput(phoneInput);

    const msg = {
      sending: form.dataset.msgSending ?? "",
      success: form.dataset.msgSuccess ?? "",
      error: form.dataset.msgError ?? "",
      network: form.dataset.msgNetwork ?? "",
      window: form.dataset.msgWindow ?? "",
    };

    const setStatus = (message: string, tone: "idle" | "error" | "success") => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.hidden = message === "";
      statusEl.className =
        "text-sm " +
        (tone === "error"
          ? "text-flux-magenta"
          : tone === "success"
            ? "text-flux-blue"
            : "text-ink-400");
    };

    const toISO = (v: string) => {
      if (!v) return "";
      const d = new Date(v);
      return Number.isNaN(d.getTime()) ? "" : d.toISOString();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const start = toISO(String(data.get("startDate") ?? ""));
      const end = toISO(String(data.get("endDate") ?? ""));

      if (start && end && new Date(end) <= new Date(start)) {
        setStatus(msg.window, "error");
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      setStatus(msg.sending, "idle");

      const payload = {
        name: String(data.get("name") ?? ""),
        surname: String(data.get("surname") ?? ""),
        email: String(data.get("email") ?? ""),
        phoneNumber: phoneInput ? getPhoneE164(phoneInput) : String(data.get("phoneNumber") ?? ""),
        company: String(data.get("company") ?? ""),
        linkedinProfile: String(data.get("linkedinProfile") ?? ""),
        startDate: start,
        endDate: end,
        message: String(data.get("message") ?? ""),
      };

      try {
        const res = await fetch("/api/book", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };

        if (res.ok && body.ok) {
          form.reset();
          setStatus(msg.success, "success");
        } else {
          setStatus(body.message ?? msg.error, "error");
        }
      } catch {
        setStatus(msg.network, "error");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
