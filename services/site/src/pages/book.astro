---
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import Field from "@atoms/Field.astro";
import Button from "@atoms/Button.astro";
import Icon from "@atoms/Icon.astro";
import Divider from "@atoms/Divider.astro";
import { site } from "@lib/site";

const title = "Book a call";
const description =
  "Book a 30-minute intro call with Computeflux. Tell us your AI systems problem — we'll tell you honestly whether we can help move the numbers that matter.";

const expect = [
  "A focused 30 minutes — no sales script.",
  "An honest read on whether we're the right studio for your problem.",
  "If it's a fit, a rough shape for an engagement and next steps.",
];
---

<PageLayout title={title} description={description}>
  <PageHero
    eyebrow="Let's talk"
    title="Book a 30-minute call"
    lead={description}
  />

  <section class="container-flux pb-24">
    <Divider label="SCHEDULE" />
    <div class="grid gap-12 py-12 lg:grid-cols-[1fr_1.2fr]">
      <!-- What to expect -->
      <div class="flex flex-col gap-6">
        <h2 class="text-xl font-semibold text-ink-50">What to expect</h2>
        <ul class="flex flex-col gap-3">
          {
            expect.map((e) => (
              <li class="flex items-start gap-3 text-ink-200">
                <span class="mt-1 shrink-0 text-flux-blue"><Icon name="check" size={16} /></span>
                <span class="text-pretty leading-relaxed">{e}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-ink-900/40 p-5">
          <p class="text-sm text-ink-300">
            Prefer email? Reach us directly at
            <a href={`mailto:${site.email}`} class="text-flux-blue hover:underline">{site.email}</a>.
          </p>
        </div>
      </div>

      <!-- Booking -->
      <div class="flex flex-col gap-5 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-ink-900/50 p-7">
        <div class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-full border border-[var(--color-border)] text-flux-blue">
            <Icon name="calendar" size={18} />
          </span>
          <div class="flex flex-col">
            <h2 class="text-lg font-semibold text-ink-50">Request a slot</h2>
            <p class="text-sm text-ink-400">Tell us when suits you — we'll confirm by email within one business day.</p>
          </div>
        </div>

        <form class="flex flex-col gap-4" data-book-form aria-label="Request a 30-minute call">
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label="First name" name="name" required />
            <Field label="Last name" name="surname" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label="Email" name="email" type="email" required />
            <Field label="Phone number" name="phoneNumber" type="tel" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label="Company" name="company" hint="Optional" />
            <Field
              label="LinkedIn profile"
              name="linkedinProfile"
              type="url"
              placeholder="https://www.linkedin.com/in/…"
              hint="Optional"
            />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <Field label="Preferred window — from" name="startDate" type="datetime-local" required />
            <Field label="…until" name="endDate" type="datetime-local" required />
          </div>
          <Field
            label="What would you like to solve?"
            name="message"
            as="textarea"
            rows={4}
            required
          />
          <Button type="submit" variant="primary" fullWidth arrow>Request call</Button>

          <p
            data-book-status
            role="status"
            aria-live="polite"
            hidden
            class="text-sm text-ink-400"
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import { enhancePhoneInput, getPhoneE164 } from "@lib/client/phone";

  const form = document.querySelector<HTMLFormElement>("[data-book-form]");

  if (form) {
    const statusEl = form.querySelector<HTMLElement>("[data-book-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const phoneInput = form.querySelector<HTMLInputElement>('input[name="phoneNumber"]');
    if (phoneInput) enhancePhoneInput(phoneInput);

    const setStatus = (message: string, tone: "idle" | "error" | "success") => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.hidden = message === "";
      statusEl.className =
        "text-sm " +
        (tone === "error"
          ? "text-flux-magenta"
          : tone === "success"
            ? "text-flux-blue"
            : "text-ink-400");
    };

    const toISO = (v: string) => {
      if (!v) return "";
      const d = new Date(v);
      return Number.isNaN(d.getTime()) ? "" : d.toISOString();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const start = toISO(String(data.get("startDate") ?? ""));
      const end = toISO(String(data.get("endDate") ?? ""));

      if (start && end && new Date(end) <= new Date(start)) {
        setStatus("The end of your window must be after the start.", "error");
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      setStatus("Sending your request…", "idle");

      const payload = {
        name: String(data.get("name") ?? ""),
        surname: String(data.get("surname") ?? ""),
        email: String(data.get("email") ?? ""),
        phoneNumber: phoneInput ? getPhoneE164(phoneInput) : String(data.get("phoneNumber") ?? ""),
        company: String(data.get("company") ?? ""),
        linkedinProfile: String(data.get("linkedinProfile") ?? ""),
        startDate: start,
        endDate: end,
        message: String(data.get("message") ?? ""),
      };

      try {
        const res = await fetch("/api/book", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };

        if (res.ok && body.ok) {
          form.reset();
          setStatus(
            "Thanks — your request is in. We'll confirm a time by email within one business day.",
            "success",
          );
        } else {
          setStatus(body.message ?? "Something went wrong. Please try again.", "error");
        }
      } catch {
        setStatus("Network error. Please try again, or email us directly.", "error");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
