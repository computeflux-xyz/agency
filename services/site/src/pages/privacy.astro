---
import PageLayout from "@layouts/PageLayout.astro";
import PageHero from "@organisms/PageHero.astro";
import { site } from "@lib/site";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
---

<PageLayout title={t("privacy.title")} description={t("privacy.metaDescription")} noindex>
  <PageHero eyebrow={t("privacy.hero.eyebrow")} title={t("privacy.hero.title")} lead={`${t("privacy.updated")} : ${t("privacy.updatedDate")}`} />

  <section class="container-prose prose-flux pb-24">
    <p>{t("privacy.intro")}</p>

    <h2>{t("privacy.collectTitle")}</h2>
    <p>{t("privacy.collectBody")}</p>

    <h2>{t("privacy.useTitle")}</h2>
    <p>{t("privacy.useBody")}</p>

    <h2>{t("privacy.analyticsTitle")}</h2>
    <p>{t("privacy.analyticsBody")}</p>

    <h2>{t("privacy.rightsTitle")}</h2>
    <p>
      {t("privacy.rightsBody")} <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <h2>{t("nav.contact")}</h2>
    <p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </section>
</PageLayout>
