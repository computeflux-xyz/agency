---
/**
 * Landing page.
 *
 * Server-rendered rather than prerendered: `HomeStudies` and `HomeArticles` read
 * live data from site-api and remove themselves entirely when it has nothing to
 * show, which only works if the decision is made per request. That also makes
 * `Astro.locals.runtime.env.API_BASE_URL` available to them (it does not exist at
 * build time). Every other section is static markup fed from i18n and `@data`.
 *
 * Section order is deliberate: hook (hero) → self-qualification (diagnostic) →
 * proof (systems we run) → capability (practices) → positioning (sovereignty,
 * energy and cost) → objection handling (why) → evidence (studies) → process
 * (approach) → depth (writing) → ask (CTA).
 */
export const prerender = false;

import PageLayout from "@layouts/PageLayout.astro";
import Hero from "@organisms/Hero.astro";
import HeroBackground from "@organisms/HeroBackground.astro";
import DiagnosticSection from "@organisms/DiagnosticSection.astro";
import HomeStudies from "@organisms/HomeStudies.astro";
import ProductionSystems from "@organisms/ProductionSystems.astro";
import PracticesSection from "@organisms/PracticesSection.astro";
import VosProblematiques from "@organisms/VosProblematiques.astro";
import HomeArticles from "@organisms/HomeArticles.astro";
import ApproachSection from "@organisms/ApproachSection.astro";
import CtaSection from "@organisms/CtaSection.astro";
---

<PageLayout dragon>
  {/* Rendered on the negative-z page underlay, so the dragon (z:0) flies in
      front of the photo while the hero text (z:1) stays above both. */}
  <HeroBackground slot="underlay" />
  <Hero />
  <DiagnosticSection />
  <HomeStudies />
  <ProductionSystems />
  <PracticesSection />
  <VosProblematiques />
  <HomeArticles />
  <ApproachSection />
  <CtaSection />
</PageLayout>
