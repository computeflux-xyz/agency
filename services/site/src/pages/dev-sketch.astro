---
/* TEMPORARY visual harness for MoebiusNav — deleted before commit. */
import "../styles/global.css";
import MoebiusNav from "@molecules/MoebiusNav.astro";
import SectionHeader from "@molecules/SectionHeader.astro";
import { getExpertise } from "@data/expertise";

const others = getExpertise("fr").filter((e) => e.slug !== "data-engineering");
---

<html lang="fr">
  <head><meta charset="utf-8" /><title>dev moebius</title></head>
  <body style="margin:0;padding:16px;background:#f5f4ef">
    <SectionHeader
      eyebrow="Autres pratiques"
      accent="blue"
      title="Le reste de la pratique."
      lead="L'ingénierie de données arrive rarement seule..."
    />
    <MoebiusNav
      items={others.map((o) => ({ index: o.index, label: o.shortTitle, href: `/expertise/${o.slug}` }))}
      caption="Le reste de la pratique."
    />
  </body>
</html>
